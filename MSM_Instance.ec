op gg (s : int -> int -> int) (P : int -> R) (i : int) (u : R) :  R 
  = (multiScalarMul_Simpl s P i l) +++ l *** u.

op hh (args : int -> int -> int)  (argP : int -> R)  (argic : int) (l : int) (u : R) =  2 ^ w *** gg args argP argic u +++  (iteri l
   (fun (i1 : int) (acc0 : R) =>
      (acc0 +++ perfect_table_pure argP u i1 (args i1 argic)))
   idR).


lemma iteri_proj argP (r : R) (argic : int)  args start : forall (n : int), 0 <= n =>
   (iteri n
   (fun (i1 : int) (acc0 : bool * R) =>
      (acc0.`1 /\ xdiff acc0.`2 (perfect_table_pure argP r i1 (args i1 argic)),
       acc0.`2 +++ perfect_table_pure argP r i1 (args i1 argic)))
   (true, start)).`2
    =    (iteri n
   (fun (i1 : int) (acc0 : R) =>
      (acc0 +++ perfect_table_pure argP r i1 (args i1 argic)))
     start).
apply intind. progress. 
rewrite iteri0. auto.
  rewrite iteri0. auto. auto.
progress.
rewrite iteriS. auto.
  rewrite iteriS. auto.
simplify.   rewrite H0. auto.
qed.  


lemma comeqsimp args argP argic l r : 0 <= l =>
  (iteri l
   (fun (i1 : int) (acc0 : bool * R) =>
      (acc0.`1 /\ xdiff acc0.`2 (perfect_table_pure argP r i1 (args i1 argic)),
       acc0.`2 +++ perfect_table_pure argP r i1 (args i1 argic)))
   (true, 2 ^ w *** gg args argP argic r)).`2
 = hh args argP argic l r .
proof. move => pp.
rewrite /hh. rewrite iteri_proj. assumption.
rewrite (iteriZZZZZ (fun i1 => perfect_table_pure argP r i1 (args i1 argic))  (2 ^ w *** gg args argP argic r) l _ ). assumption. smt.
qed.


lemma spec_equiv_fun_impl argT s u P: 0 <= argT =>
   gg s P argT u = (multiScalarMulLoop argT l (perfect_table_pure P u) s (l *** u) w).`2.
proof. move => pp.
rewrite /gg.
case (multiScalarMul_Simpl s P argT l +++ l *** u = (multiScalarMulLoop argT l (perfect_table_pure P u) s (l *** u) w).`2). 
trivial.
move => ineq.
have : forall &m, 
  Pr[ MSM.completeMainLoop(P,s, u,argT) @&m :
     gg s P argT u = (multiScalarMulLoop argT l (perfect_table_pure P u) s (l *** u) w).`2  ] = 1%r.
     progress.
     have ->: 1%r = Pr[ MSM.completeMainLoop(P,s, u,argT) @&m :
         res.`2 = gg s P argT u ].
    byphoare (_: arg = (P, s, u,argT) ==> _).
    conseq (multiscalarR_helper_spec_ph P s u argT _). assumption. auto. auto.
    rewrite /gg. 
    byequiv.
    proc*.
    call {2} (completeMainLoop_spec_ph2 P s u argT _). 
    call {1} (multiscalarR_helper_spec_ph P s u argT _). skip. 
    progress. rewrite  H0. auto. smt(). auto. auto. 
   have : exists &m, true. smt().
    elim. move => &h. auto.
    move => _. rewrite /gg. move => p.
    have : Pr[MSM.completeMainLoop(P, s, u, argT) @ &h :
       false] = 1%r.
     rewrite -  ineq. apply (p &h).
  smt(@Distr).
qed.


lemma complete_optimized_equiv argP args argU  :
 equiv [ MSM.completeMain
        ~ MSM.multiScalarMulMain_Opt_Corrected :
  arg{2} = (argP, args, argU) /\ ={P,s,U} 
     ==>  (res{2}.`1 => (res{1} = res{2})) /\ (res{1}.`1 => res{2}.`1)   ].
proc.
wp.
inline MSM.multiScalarMulMain_Opt MSM.completeMainLoop.
wp.
while (
  ={P,s,U,s0,table,ic} /\ s0{2} = s{2} /\
  table{2} = perfect_table_pure P{2} U{2} /\ Targ{1} = T /\
  0 <= ic{2} <= T /\
  (u_check U{2} P{2} s{2} =>
    ={flag0} /\ (flag0{2} => ={acc} /\ acc{2} <> idR))).
  wp.
  inline MSM.completeAddLoop MSM.incompleteAddLoop.
  wp.
  while (
    ={P,s,U,s0,table,ic} /\ s0{2} = s{2} /\
    table{2} = perfect_table_pure P{2} U{2} /\ Targ{1} = T /\
    0 <= ic{2} < T /\
    ={table0,s1,ic0,jc0} /\ table0{2} = table{2} /\
    s1{2} = s{2} /\ ic0{2} = ic{2} /\ 0 <= jc0{2} <= l /\
    (u_check U{2} P{2} s{2} =>
      ={flag0} /\ (flag0{2} =>
        ={flag1} /\ (flag1{2} => ={vahe} /\ vahe{2} <> idR)))).
    wp. skip. progress;
      smt(same_res opt_never_id u_check_for_table).
  wp.
  ecall {1} (doubleLoop_spec_ph acc{1} w).
  ecall {2} (doubleLoop_spec_ph acc{2} w).
  skip. progress; smt(param_pos no_order_two_elems).
wp. skip. progress; smt(param_pos u_check_initial).
qed.

end MultiScalarMul_Abstract.

theory MultiScalarMul_Abstract_Soundness.
require import AllCore IntDiv CoreMap List.


require import AllCore Int IntDiv List StdOrder Bool.

require import BitEncoding StdBigop Bigalg.

(*---*) import Ring.IntID IntOrder BS2Int.
(*---*) import Bigint BIA.

import MultiScalarMul_Abstract MultiScalarMul_Abstract_Setup.

import IterationProps.



section.

declare module O <: OutCalls.
declare axiom  O_lossless : islossless O.getU. 

lemma MSM_soundness_param_u_ph argP args  argU : 
 phoare [ MSM.multiScalarMulMain_Opt_Corrected : 
  arg = (argP, args, argU) 
     ==>  res.`1 => res.`2 = (multiScalarMul_Simpl args argP T l) ] = 1%r.
proof.
bypr.
move=> &m Harg.
have ih: 1%r = Pr[MSM.completeMain(P{m}, s{m}, U{m}) @ &m 
  : res.`2 = multiScalarMul_Simpl args argP T l].
byphoare (_: arg = (argP, args, argU) ==> _).
conseq (multiscalarR_spec_ph argP args argU). smt(). auto.
have : Pr[MSM.multiScalarMulMain_Opt_Corrected(P{m}, s{m}, U{m}) @ &m :
   res.`1 => res.`2 = multiScalarMul_Simpl args argP T l] >=
Pr[MSM.completeMain(P{m}, s{m}, U{m}) @ &m :
   res.`2 = multiScalarMul_Simpl args argP T l].
byequiv (_: ={glob O} /\ arg{2} = (P{m}, s{m}, U{m}) /\ arg{1} = (P{m}, s{m}, U{m}) ==> res{2}.`1 => res{2}.`2 = res.`2{1} ).
proc*.
ecall (complete_optimized_equiv argP args argU).
skip. progress. smt(). smt(). smt(). auto.
smt().
smt.
auto. 
smt.
smt.
qed.


lemma MSM_soundness argP args &m : 
 Pr[ MultiScalarMul(O).run(argP, args) @&m : 
    res.`1 => res.`2 = (multiScalarMul_Simpl args argP T l) ] = 1%r.
proof.
byphoare (_:   arg = (argP, args)  ==> _).
proc.
seq 1 : #pre.
call (_: true). auto.
call (_: true). auto.
apply O_lossless.
auto.   
exists* u_cand. elim*. move => u_candV.
call (MSM_soundness_param_u_ph argP args u_candV).
wp.   skip. progress. 
hoare. simplify. call(_:true). auto. auto. auto. auto.
qed.   


end section.

end MultiScalarMul_Abstract_Soundness.

theory MultiScalarMul_Abstract_Completeness.
require import AllCore IntDiv CoreMap List.


require import AllCore Int IntDiv List StdOrder Bool.

require import BitEncoding StdBigop Bigalg.

(*---*) import Ring.IntID IntOrder BS2Int.
(*---*) import Bigint BIA.

import MultiScalarMul_Abstract MultiScalarMul_Abstract_Setup AuxResults IterationProps.

require import Distr.

import MultiScalarMul_Abstract_Soundness.



module UniformU : OutCalls = {
   proc getU() = {
     var u_cand;
     u_cand <$ r_distr;
     return u_cand;
   }
}.


lemma UniformU_lossless : islossless UniformU.getU.
proof. proc. rnd. skip. smt(r_distr_ll). qed.

lemma MSM_uniform_soundness P s &m :
 Pr[MultiScalarMul(UniformU).run(P, s) @ &m :
   res.`1 => res.`2 = multiScalarMul_Simpl s P T l] = 1%r.
proof. apply (MSM_soundness UniformU UniformU_lossless). qed.

(* extra assumption on the algorithm parameters  *)
axiom completeness_constraints :   forall i, 0 <= i < l
  =>  
   0 < `| (2 ^ w - 1) * (1 - i) + 2 ^ w * l | < order
  
 /\ 0 < `| (1 - 2 ^ w) * (1 + i) + 2 ^ w * l | < order.


op p1 : real = mu r_distr (fun (x : R) => x = idR).
op p2 P s : real = mu r_distr (fun (x : R) => ! u_check x P s).


lemma MSM_completeness_optimized_perfect_equiv P s &m : 
  Pr[ MultiScalarMul(UniformU).run(P,s) @&m : !res.`1 ]
   = Pr[ MultiScalarMul(UniformU).run_perfect(P,s) @&m : !res.`1 ].
byequiv (_: _ ==> res{1}.`1 = res{2}.`1).
proc.
symmetry.
ecall (complete_optimized_equiv P{1} s{1} u_cand{1}).   
call (_:true). auto. skip. smt(). auto. smt().
qed.   


lemma MSM_completeness_func_perfect_equiv P s &m :
     Pr[ MSM.multiScalarMul_Functional(P,s) @&m : !res.`1 ]
     = Pr[ MultiScalarMul(UniformU).run_perfect(P,s) @&m : !res.`1 ].
byequiv (_: _ ==> res{1}.`1 = res{2}.`1).
proc.
inline UniformU.getU.
seq 1 1 : (#pre /\ u_cand{1} = u_cand0{2}).
    rnd. skip. progress.
inline MSM.completeMain.
wp.
 exists* P{2}, s{2} , u_cand0{2}. elim*. move => argP argS argU.
call {2} (completeMainLoop_spec_ph2 argP argS argU T). smt(param_pos).
wp. skip. progress. auto. smt().
qed.


lemma MSM_loop_failure_bound argP args :
 mu r_distr (fun u =>
  !(multiScalarMulLoop T l (perfect_table_pure argP u) args (l *** u) w).`1)
 <= T%r * (l%r * (p1 + p1)).
proof.
rewrite /multiScalarMulLoop.
  have -> : (fun (x : R) =>
     ! (iteri T
          (fun (i : int) (acc : bool * R) =>
             let r =
               completeAddLoop l (perfect_table_pure argP x) args i
                 (2 ^ w *** acc.`2) in (acc.`1 /\ r.`1, r.`2))
          (true, l *** x)).`1)
     = (fun (x : R) =>
     ! (iteri T
          (fun (i : int) (acc : bool * R) =>
             let myacc = gg args argP i x in
             let r =
               completeAddLoop l (perfect_table_pure argP x) args i
                 (2 ^ w *** myacc ) in (acc.`1 /\ r.`1, r.`2))
          (true, l *** x)).`1).
apply fun_ext. move => x.
 rewrite   (iteriG (fun (x : bool * R) => x.`1) (fun (x : bool * R) => x.`2)
   (fun (i : int) (acc1 : bool ) (acc2 : R) =>
         let r =
           completeAddLoop l (perfect_table_pure argP x) args i
             (2 ^ w *** acc2) in (acc1 /\ r.`1, r.`2)) T _ (true, l *** x)  ).
smt(param_pos). simplify.
  pose f1 := (fun (i : int) (acc : bool * R) =>
         (acc.`1 /\
          (completeAddLoop l (perfect_table_pure argP x) args i
             (2 ^ w ***
              (iteri i
                 (fun (i0 : int) (acc0 : bool * R) =>
                    (acc0.`1 /\
                     (completeAddLoop l (perfect_table_pure argP x) args
                        i0 (2 ^ w *** acc0.`2)).`1,
                     (completeAddLoop l (perfect_table_pure argP x) args
                        i0 (2 ^ w *** acc0.`2)).`2)) (true, l *** x)).`2)).`1,
          (completeAddLoop l (perfect_table_pure argP x) args i
             (2 ^ w ***
              (iteri i
                 (fun (i0 : int) (acc0 : bool * R) =>
                    (acc0.`1 /\
                     (completeAddLoop l (perfect_table_pure argP x) args
                        i0 (2 ^ w *** acc0.`2)).`1,
                     (completeAddLoop l (perfect_table_pure argP x) args
                        i0 (2 ^ w *** acc0.`2)).`2)) (true, l *** x)).`2)).`2)).
   pose f2 :=       (fun (i : int) (acc : bool * R) =>
        (acc.`1 /\
         (completeAddLoop l (perfect_table_pure argP x) args i
            (2 ^ w *** (gg args argP i x))).`1,
         (completeAddLoop l (perfect_table_pure argP x) args i
            (2 ^ w *** (gg args argP i x))).`2)).
 rewrite (eq_iteri f1 f2 T _ _).
progress.
 (* apply fun_ext. move => z. apply fun_ext. move => zz. progress. *)
rewrite /f1 /f2.      
        have -> : (iteri i
        (fun (i0 : int) (acc0 : bool * R) =>
           (acc0.`1 /\
            (completeAddLoop l (perfect_table_pure argP x) args i0
               (2 ^ w *** acc0.`2)).`1,
            (completeAddLoop l (perfect_table_pure argP x) args i0
               (2 ^ w *** acc0.`2)).`2)) (true, l *** x)).`2 = gg args argP i x.
rewrite (spec_equiv_fun_impl i args x argP).  auto.
      auto. auto. auto.
apply (iteri_ub3 (fun (x : R) => l *** x)   
        (fun x i => completeAddLoop l (perfect_table_pure argP x) args i
               (2 ^ w *** (gg args argP i x) )) r_distr T (l%r * (p1 + p1)) _ ). smt(param_pos).
simplify.
move => i.
rewrite /completeAddLoop. simplify.            
have -> : (fun (r : R) =>
     ! (iteri l
          (fun (j : int) (acc : bool * R) =>
             (acc.`1 /\
              xdiff acc.`2 (perfect_table_pure argP r j (args j i)),
              acc.`2 +++ perfect_table_pure argP r j (args j i)))
          (true, 2 ^ w *** (gg args argP i r))).`1)
      =
      (fun (r : R) =>
     ! (iteri l
          (fun (j : int) (acc : bool * R) =>
             (acc.`1 /\
              xdiff (hh args argP i j r) (perfect_table_pure argP r j (args j i)),
              (hh args argP i j r) +++ perfect_table_pure argP r j (args j i)))
          (true, 2 ^ w *** (gg args argP i r))).`1).
apply fun_ext. move => r.
 rewrite   (iteriG (fun (x : bool * R) => x.`1) (fun (x : bool * R) => x.`2)
   (fun (j : int) (acc1 : bool) (acc2 : R) =>
        (acc1 /\ xdiff acc2 (perfect_table_pure argP r j (args j i)),
         acc2 +++ perfect_table_pure argP r j (args j i))) l _ (true, 2 ^ w *** gg args argP i r)  ). smt(param_pos). simplify.

 pose f1 := (fun (i0 : int) (acc : bool * R) =>
         (acc.`1 /\
          xdiff
            (iteri i0
               (fun (i1 : int) (acc0 : bool * R) =>
                  (acc0.`1 /\
                   xdiff acc0.`2 (perfect_table_pure argP r i1 (args i1 i)),
                   acc0.`2 +++ perfect_table_pure argP r i1 (args i1 i)))
               (true, 2 ^ w *** gg args argP i r)).`2
            (perfect_table_pure argP r i0 (args i0 i)),
          (iteri i0
             (fun (i1 : int) (acc0 : bool * R) =>
                (acc0.`1 /\
                 xdiff acc0.`2 (perfect_table_pure argP r i1 (args i1 i)),
                 acc0.`2 +++ perfect_table_pure argP r i1 (args i1 i)))
             (true, 2 ^ w *** gg args argP i r)).`2 +++
          perfect_table_pure argP r i0 (args i0 i))).

  pose f2 := (fun (j : int) (acc : bool * R) =>
        (acc.`1 /\ xdiff (hh args argP i j r) (perfect_table_pure argP r j (args j i)),
         (hh args argP i j r) +++ perfect_table_pure argP r j (args j i))).
     
 rewrite (eq_iteri f1 f2 l _ _).
progress. rewrite /f1 /f2.

 have -> : (iteri i0
    (fun (i1 : int) (acc0 : bool * R) =>
       (acc0.`1 /\ xdiff acc0.`2 (perfect_table_pure argP r i1 (args i1 i)),
        acc0.`2 +++ perfect_table_pure argP r i1 (args i1 i)))
    (true, 2 ^ w *** gg args argP i r)).`2
   =  (hh args argP i i0 r) .
rewrite comeqsimp. auto.
auto. auto. auto.
move => condi.
apply  (iteri_ub3 (fun (x : R) => 2 ^ w *** (gg args argP i x))
   (fun r j => (xdiff (hh args argP i j r) (perfect_table_pure argP r j (args j i)) , (hh args argP i j r) +++ perfect_table_pure argP r j (args j i))  )
   r_distr l (p1 + p1) _). smt(param_pos).
progress.

have oo : (fun (r : R) =>
     ! xdiff (hh args argP i i0 r)
         (perfect_table_pure argP r i0 (args i0 i)))
       <= (fun (r : R) =>
        ((hh args argP i i0 r) =
         (perfect_table_pure argP r i0 (args i0 i))
           \/         (hh args argP i i0 r) =
         (- perfect_table_pure argP r i0 (args i0 i)))).

move => r. progress.
     apply notxdiff. auto.
  apply (RealOrder.ler_trans  
           (mu r_distr
    (fun (r : R) =>
        ((hh args argP i i0 r) =
         (perfect_table_pure argP r i0 (args i0 i))
           \/         (hh args argP i i0 r) =
         (- perfect_table_pure argP r i0 (args i0 i))))
   )).
rewrite (mu_sub r_distr _ _ oo).       

apply mu_or_leq_param.
rewrite /hh. rewrite /perfect_table_pure. rewrite /gg.

have ->: (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l +++ l *** x) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR =
     args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x)

   = (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l +++ l *** x) +++
     (iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR)
     +++  - (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x) = idR).
apply fun_ext. move => r. smt(const_add_inj op_inv).
have ->: (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l +++ l *** x) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR +++
     - (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x) = idR)
 = (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l) +++ (2 ^ w *** (l *** x)) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR +++
     - (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x)  = idR).
     apply fun_ext. move => r.
smt.
have ->: (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l) +++ (2 ^ w *** (l *** x)) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR +++
     - (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x)  = idR)
  = (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l) +++ (2 ^ w *** (l *** x)) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j)) idR +++ i0 *** - (2 ^ w - 1) *** x +++
     - (args i0 i *** argP i0) +++ (2 ^ w - 1) *** x  = idR).
     apply fun_ext. move => r.
       pose k := 2 ^ w *** multiScalarMul_Simpl args argP i l +++ 2 ^ w *** (l *** r).

 
     rewrite  (iteriZZZZ (fun j => args j i *** argP j) i0 _ (- (2 ^ w - 1) *** r)) . smt(). simplify. rewrite op_neg_add neg_neg_id. smt(op_assoc).
 

have ->: (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++ 2 ^ w *** (l *** x) +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     i0 *** - (2 ^ w - 1) *** x +++ - args i0 i *** argP i0 +++
     (2 ^ w - 1) *** x = idR)
   = (fun (x : R) =>
     (2 ^ w *** multiScalarMul_Simpl args argP i l  +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR     +++ - args i0 i *** argP i0) +++

     ((2 ^ w - 1) *** x +++
     i0 *** - (2 ^ w - 1) *** x  +++
     2 ^ w *** (l *** x)) = idR).
apply fun_ext. move => r. smt(op_assoc op_comm).

have ->: (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     - args i0 i *** argP i0 +++
     ((2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++
      2 ^ w *** (l *** x)) =
     idR)
     =  (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     - args i0 i *** argP i0 +++ x = idR) \o (fun  x => ((2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++
      2 ^ w *** (l *** x)) ). smt().
     rewrite - dmapE. simplify.

have ->: (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     - args i0 i *** argP i0 +++ x = idR)
     = (fun x => x = idR) \o (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     - args i0 i *** argP i0 +++ x). smt().
     rewrite - dmapE.

have ->: (dmap r_distr
        (fun (x : R) =>
           (2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++
           2 ^ w *** (l *** x))) = r_distr. 
     have ->: (fun (x : R) =>
     (2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++ 2 ^ w *** (l *** x))
    = (fun (x : R) =>
     ((2 ^ w - 1) +  i0 * - (2 ^ w - 1)  + 2 ^ w * l) *** x).
       apply fun_ext. move => x.
       rewrite - neg_mul.
       rewrite - nmul_mul.
       rewrite  - nplus_dist.
       rewrite - nmul_mul.
       rewrite  - nplus_dist.
       auto.
apply (dmap_bij r_distr r_distr _ (fun (x : R) => (invertme (2 ^ w - 1 + i0 * - (2 ^ w - 1) + 2 ^ w * l) ) *** x ) ).
progress. apply r_distr_full.
progress. apply r_distr_funi.          
  progress. 
pose A := 2 ^ w - 1.
have -> : (A + i0 * -A + 2 ^ w * l) = (A + - i0 * A + 2 ^ w * l). smt().
have ->: (A + - i0 * A + 2 ^ w * l) = A * (1 - i0) + 2 ^ w * l. smt().
   
rewrite invertmeP. rewrite /A. smt(completeness_constraints). auto. 

progress. 
pose A := 2 ^ w - 1.
have -> : (A + i0 * -A + 2 ^ w * l) = (A + - i0 * A + 2 ^ w * l). smt().
have ->: (A + - i0 * A + 2 ^ w * l) = A * (1 - i0) + 2 ^ w * l. smt().
timeout 10.
have ->: (A * (1 - i0) + 2 ^ w * l) *** (invertme (A * (1 - i0) + 2 ^ w * l) *** b)
 =  invertme (A * (1 - i0) + 2 ^ w * l) *** ((A * (1 - i0) + 2 ^ w * l)  *** b).
 smt.
rewrite invertmeP. rewrite /A. smt(completeness_constraints). auto. 

   
have ->: (dmap r_distr
     (fun (x : R) =>
        2 ^ w *** multiScalarMul_Simpl args argP i l +++
        iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j)
          idR +++
        - args i0 i *** argP i0 +++ x))
   = r_distr.
apply (dmap_bij r_distr r_distr _ (fun (x : R) =>   -  (2 ^ w *** multiScalarMul_Simpl args argP i l +++
        iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j)
          idR +++
        - args i0 i *** argP i0)  +++ x )).
progress. apply r_distr_full.
progress. apply r_distr_funi.
progress. apply op_cancel_left.
progress. apply op_cancel_right.
auto.
(* second symmetrical case *)
rewrite /hh. rewrite /perfect_table_pure. rewrite /gg.

have ->: (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l +++ l *** x) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR =
     - (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x))

   = (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l +++ l *** x) +++
     (iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR)
     +++  (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x) = idR).
apply fun_ext. move => r. apply op_eq_neg.
have ->: (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l +++ l *** x) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR +++
      (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x) = idR)
 = (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l) +++ (2 ^ w *** (l *** x)) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR +++
      (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x)  = idR).
     apply fun_ext. move => r.
smt.
have ->: (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l) +++ (2 ^ w *** (l *** x)) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j +++ - (2 ^ w - 1) *** x)) idR +++
      (args i0 i *** argP i0 +++ - (2 ^ w - 1) *** x)  = idR)
  = (fun (x : R) =>
     2 ^ w *** (multiScalarMul_Simpl args argP i l) +++ (2 ^ w *** (l *** x)) +++
     iteri i0
       (fun (j : int) (acc : R) =>
          acc +++ (args j i *** argP j)) idR +++ i0 *** - (2 ^ w - 1) *** x +++
     (args i0 i *** argP i0) +++  - (2 ^ w - 1) *** x  = idR).
     apply fun_ext. move => r.
       pose k := 2 ^ w *** multiScalarMul_Simpl args argP i l +++ 2 ^ w *** (l *** r).

 
     rewrite  (iteriZZZZ (fun j => args j i *** argP j) i0 _ (- (2 ^ w - 1) *** r)) . smt(). smt(op_assoc op_comm).

have ->: (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++ 2 ^ w *** (l *** x) +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     i0 *** - (2 ^ w - 1) *** x +++ args i0 i *** argP i0 +++
     - (2 ^ w - 1) *** x = idR)
   = (fun (x : R) =>
     (2 ^ w *** multiScalarMul_Simpl args argP i l  +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR     +++  args i0 i *** argP i0) +++

     (- (2 ^ w - 1) *** x +++
     i0 *** - (2 ^ w - 1) *** x  +++
     2 ^ w *** (l *** x)) = idR).
apply fun_ext. move => r. smt(op_assoc op_comm).

have ->: (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
      args i0 i *** argP i0 +++
     (- (2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++
      2 ^ w *** (l *** x)) =
     idR)
     =  (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     args i0 i *** argP i0 +++ x = idR) \o (fun  x => (-(2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++
      2 ^ w *** (l *** x)) ). smt().
     rewrite - dmapE. simplify.

have ->: (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
     args i0 i *** argP i0 +++ x = idR)
     = (fun x => x = idR) \o (fun (x : R) =>
     2 ^ w *** multiScalarMul_Simpl args argP i l +++
     iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j) idR +++
      args i0 i *** argP i0 +++ x). smt().
     rewrite - dmapE.

have ->: (dmap r_distr
        (fun (x : R) =>
           - (2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++
           2 ^ w *** (l *** x))) = r_distr. 
     have ->: (fun (x : R) =>
     - (2 ^ w - 1) *** x +++ i0 *** - (2 ^ w - 1) *** x +++ 2 ^ w *** (l *** x))
    = (fun (x : R) =>
     (- (2 ^ w - 1) +  i0 * - (2 ^ w - 1)  + 2 ^ w * l) *** x).
       apply fun_ext. move => x.
       rewrite - neg_mul.
       rewrite - nmul_mul.
       rewrite  - nplus_dist.
       rewrite - nmul_mul.
       rewrite  - nplus_dist.
       auto.
apply (dmap_bij r_distr r_distr _ (fun (x : R) => (invertme (- (2 ^ w - 1) + i0 * - (2 ^ w - 1) + 2 ^ w * l) ) *** x ) ).
progress. apply r_distr_full.
progress. apply r_distr_funi.          
  progress. rewrite invertmeP.
smt(completeness_constraints).   
auto.

progress.
 have ->: ((- (2 ^ w - 1)) + i0 * - (2 ^ w - 1) + 2 ^ w * l) ***
(invertme ((- (2 ^ w - 1)) + i0 * - (2 ^ w - 1) + 2 ^ w * l) *** b)
  = (invertme ((- (2 ^ w - 1)) + i0 * - (2 ^ w - 1) + 2 ^ w * l)) ***
( ((- (2 ^ w - 1)) + i0 * - (2 ^ w - 1) + 2 ^ w * l) *** b). smt.   
rewrite invertmeP.
smt(completeness_constraints).    auto.
  
have ->: (dmap r_distr
     (fun (x : R) =>
        2 ^ w *** multiScalarMul_Simpl args argP i l +++
        iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j)
          idR +++
        args i0 i *** argP i0 +++ x))
   = r_distr.
apply (dmap_bij r_distr r_distr _ (fun (x : R) =>   -  (2 ^ w *** multiScalarMul_Simpl args argP i l +++
        iteri i0 (fun (j : int) (acc : R) => acc +++ args j i *** argP j)
          idR +++
         args i0 i *** argP i0)  +++ x )).
progress. apply r_distr_full.
progress. apply r_distr_funi.
progress. apply op_cancel_left.
progress. apply op_cancel_right.
auto.
qed.

lemma MSM_completeness_functional argP args :
  phoare [ MSM.multiScalarMul_Functional :
      arg = (argP , args) ==> !res.`1 ]
            <= ((p2 argP args) + (T%r * (l%r * (p1 + p1)))).
proc.
wp. rnd. skip. progress.
simplify.
rewrite mu_split. simplify.
apply mu_split_q.
apply kkkk. smt().
auto.
apply MSM_loop_failure_bound.
progress. rewrite /p1 /p2. smt(ge0_mu param_pos).
qed.


lemma MSM_completeness argP args &m : 
  Pr[ MultiScalarMul(UniformU).run(argP,args) @&m : !res.`1 ]
       <= ((p2 argP args) + T%r * (l%r * (p1 + p1))).
rewrite MSM_completeness_optimized_perfect_equiv.
rewrite - MSM_completeness_func_perfect_equiv.
byphoare (_: arg = (argP , args) ==> _).
apply MSM_completeness_functional. auto. auto.
qed.  


(* Normalization makes returned success complementary to returned failure. *)
lemma MSM_uniform_lossless : islossless MultiScalarMul(UniformU).run.
proof.
proc.
ecall (MSM_soundness_param_u_ph UniformU UniformU_lossless P s u_cand); call UniformU_lossless; auto.
qed.

lemma MSM_uniform_success P s &m :
 1%r - (p2 P s + T%r * (l%r * (p1 + p1)))
 <= Pr[MultiScalarMul(UniformU).run(P,s) @ &m : res.`1].
proof.
have Hfail := MSM_completeness P s &m.
have Htotal : Pr[MultiScalarMul(UniformU).run(P,s) @ &m : true] = 1%r
 by byphoare MSM_uniform_lossless.
move: Hfail. rewrite Pr [mu_not] Htotal.
smt().
qed.

end MultiScalarMul_Abstract_Completeness.

theory MSM_TableConstruction.
require import AllCore Int IntDiv StdOrder.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract.

import IntOrder.

(* A row contains k*P - V for 0 <= k < b. *)
op table_entry (p v : R) (k : int) : R = k *** p +++ -v.
op add_safe (a b : R) = a <> idR /\ b <> idR /\ xdiff a b.
op row_safe (p v : R) (n : int) =
  p <> idR /\
  (forall k, 0 <= k < n => table_entry p v k <> idR) /\
  (forall k, 0 <= k < n - 1 => xdiff (table_entry p v k) p).

lemma table_entry0 p v : table_entry p v 0 = -v.
proof. by rewrite /table_entry zero_mul op_id'. qed.

lemma table_entryS p v k :
 table_entry p v (k+1) = table_entry p v k +++ p.
proof. rewrite /table_entry nplus_dist one_mul. smt(op_assoc op_comm). qed.

lemma add_safe_result a b : add_safe a b =>
 a %%% b = a +++ b /\ a +++ b <> idR.
proof. rewrite /add_safe /xdiff. smt(same_res opt_never_id). qed.

lemma row_safe1 p v : row_safe p v 1 = (p <> idR /\ -v <> idR).
proof. rewrite /row_safe. smt(table_entry0). qed.

lemma row_safeS p v n : 1 <= n =>
 row_safe p v (n+1) =
 (row_safe p v n /\ add_safe (table_entry p v (n-1)) p).
proof.
move=> Hn.
have Hnext := add_safe_result (table_entry p v (n-1)) p.
have Heq : table_entry p v n = table_entry p v (n-1) +++ p
 by rewrite -table_entryS; congr; smt().
move: Hnext. rewrite /row_safe /add_safe.
smt().
qed.

module TableBuilder = {
 proc row(p v : R, b : int) = {
  var entries : int -> R;
  var q : R;
  var i : int;
  var ok : bool;
  q <- -v;
  entries <- fun k => if k = 0 then q else idR;
  ok <- 0 < b /\ p <> idR /\ q <> idR;
  i <- 1;
  while (i < b) {
   if (ok) {
    ok <- add_safe q p;
    if (ok) {
     q <- q %%% p;
     entries <- fun k => if k = i then q else entries k;
    }
   }
   i <- i + 1;
  }
  return (ok, entries);
 }

 proc build(P : int -> R, U : R) = {
  var table : int -> int -> R;
  var entries : int -> R;
  var v : R;
  var j : int;
  var ok, row_ok : bool;
  table <- fun j k => idR;
  v <- (2 ^ w - 1) *** U;
  ok <- true;
  j <- 0;
  while (j < l) {
   (row_ok, entries) <@ row(P j, v, 2 ^ w);
   table <- fun h => if h = j then entries else table h;
   ok <- ok /\ row_ok;
   j <- j + 1;
  }
  return (ok, table);
 }
}.

lemma table_row_spec P V width : 0 < width =>
 phoare [TableBuilder.row : arg = (P,V,width) ==>
  (res.`1 = row_safe P V width) /\
  (res.`1 => forall k, 0 <= k < width => res.`2 k = table_entry P V k)] = 1%r.
proof.
move=> Hb.
proc.
while (p = P /\ v = V /\ b = width /\ 1 <= i <= b /\
       ok = row_safe P V i /\
       (ok => q = table_entry P V (i-1) /\
        forall k, 0 <= k < i => entries k = table_entry P V k)) (b-i).
move=> z.
wp. skip. progress; smt(row_safeS add_safe_result table_entryS).
wp. skip. progress; smt(row_safe1 table_entry0).
qed.

(* A sufficient group-level exclusion set for a complete row. *)
op row_admissible (p v : R) (b : int) =
 p <> idR /\ forall j, -1 <= j <= b-1 => v <> j *** p.

lemma table_entry_eq_mul p v k j :
 (table_entry p v k = j *** p) = (v = (k-j) *** p).
proof.
rewrite /table_entry (_: k-j = k + -j) 1:/# nplus_dist neg_mul.
smt(op_assoc op_comm op_id op_id' op_inv neg_neg_id const_add_inj).
qed.

lemma row_admissible_safe p v b : 0 < b =>
 row_admissible p v b => row_safe p v b.
proof.
rewrite /row_admissible /row_safe.
move=> Hb [Hp Hv]. split; first exact Hp.
split.
+ move=> k Hk.
  have H := table_entry_eq_mul p v k 0.
  smt(zero_mul).
+ move=> k Hk.
  have H := notxdiff (table_entry p v k) p.
  have Hplus := table_entry_eq_mul p v k 1.
  have Hminus := table_entry_eq_mul p v k (-1).
  smt(one_mul neg_mul).
qed.


op table_safe (P : int -> R) (U : R) =
 forall j, 0 <= j < l => row_safe (P j) ((2 ^ w - 1) *** U) (2 ^ w).

lemma table_build_spec argP argU :
 phoare [TableBuilder.build : arg = (argP,argU) ==>
  (res.`1 = table_safe argP argU) /\
  (res.`1 => forall j k, 0 <= j < l => 0 <= k < 2 ^ w =>
   res.`2 j k = perfect_table_pure argP argU j k)] = 1%r.
proof.
proc.
while (P = argP /\ U = argU /\ v = (2 ^ w - 1) *** argU /\
  0 <= j <= l /\
  ok = (forall h, 0 <= h < j => row_safe (argP h) v (2 ^ w)) /\
  (ok => forall h k, 0 <= h < j => 0 <= k < 2 ^ w =>
    table h k = table_entry (argP h) v k)) (l-j).
move=> z.
wp.
ecall (table_row_spec (P j) v (2 ^ w) _).
+ skip. progress; smt().
+ smt(expr_gt0).
wp. skip. rewrite /table_safe /table_entry /perfect_table_pure.
progress; smt(param_pos).
qed.


op valid_windows (s : int -> int -> int) =
 forall j i, 0 <= j < l => 0 <= i < T => 0 <= s j i < 2 ^ w.

lemma table_safe_u_check P U s : table_safe P U =>
 l *** U <> idR => valid_windows s => u_check U P s.
proof.
rewrite /table_safe /row_safe /valid_windows /u_check
 /perfect_table_pure /table_entry.
smt().
qed.

lemma admissible_table_safe P U :
 (forall j, 0 <= j < l =>
   row_admissible (P j) ((2 ^ w - 1) *** U) (2 ^ w)) =>
 table_safe P U.
proof. rewrite /table_safe. smt(row_admissible_safe expr_gt0). qed.


lemma table_build_spec_h argP argU :
 hoare [TableBuilder.build : arg = (argP,argU) ==>
  (res.`1 = table_safe argP argU) /\
  (res.`1 => forall j k, 0 <= j < l => 0 <= k < 2 ^ w =>
   res.`2 j k = perfect_table_pure argP argU j k)].
proof. conseq (table_build_spec argP argU); smt(). qed.

end MSM_TableConstruction.

theory MSM_WithTable.
require import AllCore Int StdOrder.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MultiScalarMul_Abstract_Soundness MultiScalarMul_Abstract_Completeness MSM_TableConstruction.


op table_matches (table : int -> int -> R) P U =
 forall j k, 0 <= j < l => 0 <= k < 2 ^ w =>
  table j k = perfect_table_pure P U j k.

module ConstructedMSM = {
 proc with_table(P : int -> R, s : int -> int -> int, U : R,
                 table : int -> int -> R) = {
  var acc : R;
  var ic : int;
  var accepted, flag, step_ok : bool;
  accepted <- l *** U <> idR;
  flag <- true;
  acc <- l *** U;
  ic <- 0;
  while (ic < T) {
   acc <@ MSM.doubleLoop(acc,w);
   (step_ok, acc) <@ MSM.incompleteAddLoop(acc,table,ic,s);
   flag <- flag /\ step_ok;
   ic <- ic + 1;
  }
  return (accepted /\ flag, acc +++ -(l *** U));
 }

 proc run(P : int -> R, s : int -> int -> int, U : R) = {
  var table : int -> int -> R;
  var built : bool;
  var result : bool * R;
  (built, table) <@ TableBuilder.build(P,U);
  result <- (false,idR);
  if (built /\ valid_windows s) {
   result <@ with_table(P,s,U,table);
  }
  return result;
 }
}.


lemma add_loop_table_equiv :
 equiv [MSM.incompleteAddLoop ~ MSM.incompleteAddLoop :
  ={acc,ic,s} /\
  (forall j, 0 <= j < l => table{1} j (s{1} j ic{1}) = table{2} j (s{2} j ic{2}))
  ==> ={res}].
proof.
proc.
while (={acc,ic,s,jc,vahe,flag} /\ 0 <= jc{1} <= l /\
  (forall j, 0 <= j < l => table{1} j (s{1} j ic{1}) = table{2} j (s{2} j ic{2}))).
+ wp. skip. progress; smt().
wp. skip. progress; smt(param_pos).
qed.

lemma with_table_equiv :
 equiv [ConstructedMSM.with_table ~ MSM.multiScalarMulMain_Opt_Corrected :
  ={P,s,U} /\ valid_windows s{1} /\ table_matches table{1} P{1} U{1} /\ table_safe P{1} U{1}
  ==> ={res}].
proof.
proc.
inline MSM.multiScalarMulMain_Opt.
wp.
while (={P,s,U,acc,ic} /\ s0{2} = s{1} /\
 flag{1} = flag0{2} /\ accepted{1} = flag{2} /\ 0 <= ic{1} <= T /\
 table{2} = perfect_table_pure P{2} U{2} /\
 table_matches table{1} P{1} U{1} /\ valid_windows s{1} /\ table_safe P{1} U{1}).
+ wp.
  call add_loop_table_equiv.
  call (_: true). sim.
  skip. rewrite /table_matches /valid_windows. progress; smt().
wp. skip. progress; smt(param_pos table_safe_u_check u_check_initial).
qed.


lemma with_table_soundness argP args argU argTable :
 phoare [ConstructedMSM.with_table :
  arg = (argP,args,argU,argTable) /\
  valid_windows args /\ table_matches argTable argP argU /\ table_safe argP argU ==>
  res.`1 => res.`2 = multiScalarMul_Simpl args argP T l] = 1%r.
proof.
bypr. move=> &m Harg.
have ->: Pr[ConstructedMSM.with_table(P{m},s{m},U{m},table{m}) @ &m :
 res.`1 => res.`2 = multiScalarMul_Simpl args argP T l] =
 Pr[MSM.multiScalarMulMain_Opt_Corrected(argP,args,argU) @ &m :
 res.`1 => res.`2 = multiScalarMul_Simpl args argP T l].
+ byequiv with_table_equiv; smt().
byphoare (MSM_soundness_param_u_ph UniformU UniformU_lossless argP args argU); smt().
qed.

lemma constructed_msm_soundness argP args argU :
 phoare [ConstructedMSM.run : arg = (argP,args,argU) ==>
  res.`1 => res.`2 = multiScalarMul_Simpl args argP T l] = 1%r.
proof.
proc.
seq 1 : (P = argP /\ s = args /\ U = argU /\
 built = table_safe argP argU /\ (built => table_matches table argP argU)).
+ call (table_build_spec_h argP argU). auto.
+ call (table_build_spec argP argU).
  skip. rewrite /table_matches. progress; smt().
+ sp 1. if.
  + ecall (with_table_soundness argP args argU table); skip; progress; smt().
  + wp. skip. progress; smt().
+ hoare. call (table_build_spec_h argP argU).
  skip. rewrite /table_matches. progress; smt().
+ auto.
qed.


module SampledConstructedMSM = {
 proc run(P : int -> R, s : int -> int -> int) = {
  var u : R;
  var result : bool * R;
  u <$ r_distr;
  result <@ ConstructedMSM.run(P,s,u);
  return result;
 }
}.

lemma sampled_constructed_msm_soundness argP args :
 phoare [SampledConstructedMSM.run : arg = (argP,args) ==>
  res.`1 => res.`2 = multiScalarMul_Simpl args argP T l] = 1%r.
proof.
proc.
ecall (constructed_msm_soundness argP args u).
rnd. skip. progress; smt(r_distr_ll).
progress; smt(r_distr_ll).
qed.

end MSM_WithTable.

theory MSM_RejectionBound.
require import AllCore Distr Int IntDiv StdOrder List Finite.

import AuxResults MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MultiScalarMul_Abstract_Completeness MSM_TableConstruction MSM_WithTable.

import IntOrder.

(* Union bound for a finite integer interval; no independence is assumed. *)
lemma mu_exists_interval ['a] (d : 'a distr) (E : int -> 'a -> bool)
 (lo n : int) (eps : real) :
 0 <= n =>
 (forall i, lo <= i < lo+n => mu d (E i) <= eps) =>
 mu d (fun x => exists i, lo <= i < lo+n /\ E i x) <= n%r * eps.
proof.
elim/natind: n.
+ move=> n Hn Hnonneg Hbound.
  have ->: n = 0 by smt().
  have ->: (fun x => exists i, lo <= i < lo+0 /\ E i x) = (fun x => false)
    by apply fun_ext; smt().
  rewrite mu0. smt().
+ move=> n Hn IH Hnonneg Hbound.
  have ->: (fun x => exists i, lo <= i < lo+(n+1) /\ E i x) =
    (fun x => (exists i, lo <= i < lo+n /\ E i x) \/ E (lo+n) x)
    by apply fun_ext; smt().
  have Hprev: mu d (fun x => exists i, lo <= i < lo+n /\ E i x) <= n%r * eps
    by apply IH; smt().
  have Hlast: mu d (E (lo+n)) <= eps by apply Hbound; smt().
  have Hunion := mu_or_leq_param d (n%r*eps) eps _ _ Hprev Hlast.
  smt().
qed.

(* Multiplication by n must be invertible on this group. *)
op scalar_invertible (n : int) =
 forall x, invertme n *** (n *** x) = x.

lemma scalar_invertible_small n : 0 < `|n| < order => scalar_invertible n.
proof. rewrite /scalar_invertible. smt(invertmeP). qed.

lemma scalar_event_mass n y : scalar_invertible n =>
 mu r_distr (fun u => n *** u = y) = p1.
proof.
move=> Hinv.
have Hmap: dmap r_distr (fun u => n *** u) = r_distr.
 apply (dmap_bij r_distr r_distr (fun u => n *** u) (fun u => invertme n *** u)).
 + progress. apply r_distr_full.
 + progress. apply r_distr_funi.
 + rewrite /scalar_invertible in Hinv. smt().
 + rewrite /scalar_invertible in Hinv. smt(nmul_mul).
have ->: (fun u => n *** u = y) = (fun x => x = y) \o (fun u => n *** u) by smt().
rewrite -dmapE Hmap /p1.
exact (r_distr_funi y idR).
qed.


lemma row_rejection_bound P b : 0 < b => P <> idR =>
 scalar_invertible (b-1) =>
 mu r_distr (fun u => ! row_safe P ((b-1) *** u) b) <= (b+1)%r * p1.
proof.
move=> Hb HP Hinv.
apply (RealOrder.ler_trans
 (mu r_distr (fun u => exists k, -1 <= k < -1+(b+1) /\ (b-1) *** u = k *** P))).
+ apply mu_sub. move=> u Hbad.
  have H := row_admissible_safe P ((b-1) *** u) b Hb.
  rewrite /row_admissible in H. smt().
apply (mu_exists_interval r_distr (fun k u => (b-1) *** u = k *** P) (-1) (b+1) p1).
+ smt().
+ move=> k Hk. rewrite (scalar_event_mass (b-1) (k *** P) Hinv). smt().
qed.

op nonzero_bases (P : int -> R) = forall j, 0 <= j < l => P j <> idR.

lemma table_rejection_bound P : nonzero_bases P =>
 scalar_invertible (2 ^ w - 1) =>
 mu r_distr (fun u => ! table_safe P u) <= l%r * ((2 ^ w + 1)%r * p1).
proof.
move=> HP Hinv.
apply (RealOrder.ler_trans
 (mu r_distr (fun u => exists j, 0 <= j < 0+l /\
  ! row_safe (P j) ((2 ^ w - 1) *** u) (2 ^ w)))).
+ apply mu_sub. rewrite /table_safe. smt().
apply (mu_exists_interval r_distr
 (fun j u => ! row_safe (P j) ((2 ^ w - 1) *** u) (2 ^ w)) 0 l ((2 ^ w + 1)%r * p1)).
+ smt(param_pos).
+ move=> j Hj. apply row_rejection_bound.
  + smt(expr_gt0).
  + move: HP. rewrite /nonzero_bases. smt().
  + exact Hinv.
qed.

op loop_ok P s u =
 (multiScalarMulLoop T l (perfect_table_pure P u) s (l *** u) w).`1.

op construction_accepts P s u =
 table_safe P u /\ valid_windows s /\ l *** u <> idR /\ loop_ok P s u.

op rejection_bound : real = (1 + l * (2 ^ w + 1) + 2*T*l)%r * p1.

lemma construction_failure_mass P s :
 nonzero_bases P => valid_windows s =>
 scalar_invertible (2 ^ w - 1) => scalar_invertible l =>
 mu r_distr (fun u => ! construction_accepts P s u) <= rejection_bound.
proof.
move=> HP Hs Htable Hinitial.
have Hrow := table_rejection_bound P HP Htable.
have Hinit := scalar_event_mass l idR Hinitial.
have Hloop := MSM_loop_failure_bound P s.
have ->: (fun u => ! construction_accepts P s u) =
 (fun u => ! table_safe P u \/ (l *** u = idR \/ !loop_ok P s u))
 by apply fun_ext; rewrite /construction_accepts; smt().
apply (RealOrder.ler_trans
 (l%r * ((2 ^ w + 1)%r * p1) + (p1 + T%r * (l%r * (p1 + p1))))).
+ apply mu_or_leq_param.
  + exact Hrow.
  + apply mu_or_leq_param.
    + smt().
    + exact Hloop.
rewrite /rejection_bound. smt(Real.fromintD Real.fromintM).
qed.


lemma complete_flag_spec argP args argU :
 phoare [MSM.completeMain : arg = (argP,args,argU) ==>
  res.`1 = (u_check argU argP args /\ loop_ok argP args argU)] = 1%r.
proof.
proc.
ecall (completeMainLoop_spec_ph2 argP args argU T _).
+ wp. skip. rewrite /loop_ok. progress; smt().
+ smt(param_pos).
qed.

lemma optimized_flag_spec argP args argU :
 phoare [MSM.multiScalarMulMain_Opt_Corrected : arg = (argP,args,argU) ==>
  res.`1 = (u_check argU argP args /\ loop_ok argP args argU)] = 1%r.
proof.
bypr. move=> &m Harg.
have ->: Pr[MSM.multiScalarMulMain_Opt_Corrected(P{m},s{m},U{m}) @ &m :
 res.`1 = (u_check argU argP args /\ loop_ok argP args argU)] =
 Pr[MSM.completeMain(argP,args,argU) @ &m :
 res.`1 = (u_check argU argP args /\ loop_ok argP args argU)].
+ byequiv (_: arg{1} = (argP,args,argU) /\ ={P,s,U} ==> res{1}.`1 = res{2}.`1).
  + symmetry. conseq (complete_optimized_equiv argP args argU); smt().
  + smt().
  + smt().
byphoare (complete_flag_spec argP args argU); smt().
qed.

lemma supplied_table_flag_spec argP args argU argTable :
 phoare [ConstructedMSM.with_table :
  arg = (argP,args,argU,argTable) /\ valid_windows args /\
  table_matches argTable argP argU /\ table_safe argP argU ==>
  res.`1 = construction_accepts argP args argU] = 1%r.
proof.
bypr. move=> &m Harg.
have ->: Pr[ConstructedMSM.with_table(P{m},s{m},U{m},table{m}) @ &m :
 res.`1 = construction_accepts argP args argU] =
 Pr[MSM.multiScalarMulMain_Opt_Corrected(argP,args,argU) @ &m :
 res.`1 = (u_check argU argP args /\ loop_ok argP args argU)].
+ byequiv with_table_equiv; rewrite /construction_accepts; smt(table_safe_u_check u_check_initial).
byphoare (optimized_flag_spec argP args argU); smt().
qed.

lemma constructed_flag_spec argP args argU :
 phoare [ConstructedMSM.run : arg = (argP,args,argU) ==>
  res.`1 = construction_accepts argP args argU] = 1%r.
proof.
proc.
seq 1 : (P = argP /\ s = args /\ U = argU /\
 built = table_safe argP argU /\ (built => table_matches table argP argU)).
+ call (table_build_spec_h argP argU). auto.
+ call (table_build_spec argP argU).
  skip. rewrite /table_matches. progress; smt().
+ sp 1. if.
  + ecall (supplied_table_flag_spec argP args argU table); skip; progress; smt().
  + wp. skip. rewrite /construction_accepts. progress; smt().
+ hoare. call (table_build_spec_h argP argU).
  skip. rewrite /table_matches. progress; smt().
+ auto.
qed.


(* Proof-only functional view of the acceptance event. *)
module ConstructionEvent = {
 proc run(P : int -> R, s : int -> int -> int) = {
  var u : R;
  u <$ r_distr;
  return construction_accepts P s u;
 }
}.

lemma construction_event_equiv :
 equiv [SampledConstructedMSM.run ~ ConstructionEvent.run :
  ={P,s} ==> res{1}.`1 = res{2}].
proof.
proc.
ecall {1} (constructed_flag_spec P{1} s{1} u{1}).
rnd. skip. progress; smt().
qed.

lemma sampled_rejection_mass argP args &m :
 Pr[SampledConstructedMSM.run(argP,args) @ &m : !res.`1] =
 mu r_distr (fun u => !construction_accepts argP args u).
proof.
have ->: Pr[SampledConstructedMSM.run(argP,args) @ &m : !res.`1] =
 Pr[ConstructionEvent.run(argP,args) @ &m : !res].
+ byequiv construction_event_equiv; smt().
byphoare (_: arg = (argP,args) ==> _).
+ proc. rnd. skip. progress.
+ auto.
+ auto.
qed.

lemma sampled_rejection_bound P s &m :
 nonzero_bases P => valid_windows s =>
 scalar_invertible (2 ^ w - 1) => scalar_invertible l =>
 Pr[SampledConstructedMSM.run(P,s) @ &m : !res.`1] <= rejection_bound.
proof.
move=> HP Hs Htable Hinitial.
rewrite sampled_rejection_mass.
exact (construction_failure_mass P s HP Hs Htable Hinitial).
qed.


(* Full support and uniformity make this a finite enumeration of R. *)
op group_elements : R list = to_seq (support r_distr).
op group_cardinality : int = size group_elements.

lemma group_elements_complete x : x \in group_elements.
proof.
rewrite /group_elements mem_to_seq.
+ exact (uniform_finite r_distr r_distr_uni).
+ exact (r_distr_full x).
qed.

lemma group_elements_unique : uniq group_elements.
proof. rewrite /group_elements. exact uniq_to_seq. qed.

lemma group_cardinality_positive : 0 < group_cardinality.
proof.
have H := group_elements_complete idR.
rewrite /group_cardinality. smt(size_ge0 size_eq0 in_nil).
qed.

lemma point_mass_cardinality : p1 = 1%r / group_cardinality%r.
proof.
rewrite /p1 /group_cardinality /group_elements.
have ->: (fun (x : R) => x = idR) = pred1 idR
 by apply fun_ext; rewrite /pred1; smt().
by rewrite (mu1_uni_ll r_distr idR r_distr_uni r_distr_ll) (r_distr_full idR) /=.
qed.

lemma sampled_rejection_bound_cardinality P s &m :
 nonzero_bases P => valid_windows s =>
 scalar_invertible (2 ^ w - 1) => scalar_invertible l =>
 Pr[SampledConstructedMSM.run(P,s) @ &m : !res.`1]
 <= (1 + l * (2 ^ w + 1) + 2*T*l)%r / group_cardinality%r.
proof.
move=> HP Hs Htable Hinitial.
have H := sampled_rejection_bound P s &m HP Hs Htable Hinitial.
move: H. rewrite /rejection_bound point_mass_cardinality. smt().
qed.


lemma sampled_constructed_lossless : islossless SampledConstructedMSM.run.
proof.
proc*. ecall (sampled_constructed_msm_soundness P s); auto.
qed.

lemma sampled_success_bound_cardinality P s &m :
 nonzero_bases P => valid_windows s =>
 scalar_invertible (2 ^ w - 1) => scalar_invertible l =>
 1%r - (1 + l * (2 ^ w + 1) + 2*T*l)%r / group_cardinality%r
 <= Pr[SampledConstructedMSM.run(P,s) @ &m : res.`1].
proof.
move=> HP Hs Htable Hinitial.
have Hfail := sampled_rejection_bound_cardinality P s &m HP Hs Htable Hinitial.
have Htotal: Pr[SampledConstructedMSM.run(P,s) @ &m : true] = 1%r
 by byphoare sampled_constructed_lossless.
move: Hfail. rewrite Pr [mu_not] Htotal. smt().
qed.

(* Sufficient numerical conditions using the existing scalar-inversion axiom. *)
lemma sampled_rejection_bound_small_scalars P s &m :
 nonzero_bases P => valid_windows s =>
 0 < `|(2 ^ w - 1)| < order => 0 < `| l| < order =>
 Pr[SampledConstructedMSM.run(P,s) @ &m : !res.`1]
 <= (1 + l * (2 ^ w + 1) + 2*T*l)%r / group_cardinality%r.
proof.
move=> HP Hs Htable Hinitial.
apply (sampled_rejection_bound_cardinality P s &m HP Hs);
 apply scalar_invertible_small; assumption.
qed.

end MSM_RejectionBound.

theory MSM_TableConstraints.
require import AllCore Int IntDiv StdOrder.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MSM_TableConstruction MSM_WithTable.


(* Figure 2's three coordinate equations, with the output identity bit zero.
   x and y are integer representatives of foreign-field coordinates modulo m.
   No unequal-x guard is included in this relation. *)
op slope_constraint (x y : R -> int) m a p lam =
  (y p - y a - lam * (x p - x a)) %% m = 0.

op incomplete_constraints (x y : R -> int) m a p r lam =
  r <> idR /\ slope_constraint x y m a p lam /\
  (x a + x p + x r - lam * lam) %% m = 0 /\
  (-y r - y a - lam * (x r - x a)) %% m = 0.

(* Explicit coordinate-interface obligations, not new global axioms.
   These are the usual nonidentity/no-2-torsion, negation and x-coordinate
   properties of the intended odd-characteristic curve subgroup. *)
op coordinate_laws (x y : R -> int) m =
  1 < m /\
  (forall p, p <> idR => (2 * y p) %% m <> 0) /\
  (forall p, p <> idR =>
    (x (-p) - x p) %% m = 0 /\ (y (-p) + y p) %% m = 0) /\
  (forall a p, a <> idR => p <> idR =>
    (xdiff a p <=> (x p - x a) %% m <> 0)).

(* The same safe-input correctness obligation as the abstract addition
   interface, now stated for witnessed coordinate equations. This does not
   assume anything about exceptional-input rejection or table safety. *)
op safe_constraint_correct (x y : R -> int) m =
  forall a p r lam, add_safe a p =>
    incomplete_constraints x y m a p r lam => r = a +++ p.

lemma mod_sub_zero a b m : a %% m = 0 => b %% m = 0 =>
  (a-b) %% m = 0.
proof. move=> Ha Hb. rewrite -modzBm Ha Hb. smt(mod0z). qed.

lemma mod_mul_zero a b m : a %% m = 0 => (b*a) %% m = 0.
proof. move=> Ha. rewrite -modzMmr Ha. smt(mod0z). qed.

(* A successful addition of p cannot return p: the two slope equations
   would imply 2*y(p)=0, independently of the lambda-squared equation. *)
lemma constraints_output_not_base x y m a p r lam :
  (2 * y p) %% m <> 0 =>
  incomplete_constraints x y m a p r lam => r <> p.
proof.
rewrite /incomplete_constraints /slope_constraint.
move=> Hnonzero [Hr [Hs [Hsq Hout]]].
case (r=p)=> Heq; last smt(). subst r.
have H := mod_sub_zero _ _ m Hs Hout.
have E : (y p - y a - lam * (x p - x a)) -
  (-y p - y a - lam * (x p - x a)) = 2 * y p by ring.
smt().
qed.

(* The input -p is rejected by the first slope equation itself. *)
lemma constraints_inverse_impossible x y m p r lam :
  coordinate_laws x y m => p <> idR =>
  ! incomplete_constraints x y m (-p) p r lam.
proof.
rewrite /coordinate_laws /incomplete_constraints /slope_constraint.
move=> [Hm [Htwo [Hneg Hx]]] Hp.
case (incomplete_constraints x y m (-p) p r lam); last smt().
rewrite /incomplete_constraints /slope_constraint.
move=> [Hr [Hs [Hsq Hout]]].
have [Hxneg Hyneg] := Hneg p Hp.
have Hdelta : (x p - x (-p)) %% m = 0.
+ have H := mod_sub_zero 0 _ m (mod0z m) Hxneg.
  have E : 0 - (x (-p) - x p) = x p - x (-p) by ring.
  smt().
have Hy : (y p - y (-p)) %% m = 0.
+ have H' := mod_sub_zero _ _ m Hs (mod_mul_zero _ (-lam) m Hdelta).
  have E : (y p-y (-p)-lam*(x p-x (-p))) -
    (-lam*(x p-x (-p))) = y p-y (-p) by ring.
  smt().
have Hsum : (2*y p) %% m = 0.
+ rewrite -(_ : (y p-y (-p)) + (y (-p)+y p) = 2*y p) 1:/#.
  rewrite -modzDm Hy Hyneg. smt(mod0z).
smt().
qed.

(* Only the initial unequal-x test is present. Every later step consists
   solely of the existing Figure 2 constraints. *)
op accepted_table_row (x y : R -> int) m p v b
    (entries : int -> R) (slopes : int -> int) =
  0 < b /\ p <> idR /\ v <> idR /\
  (x p - x v) %% m <> 0 /\
  entries 0 = -v /\
  forall k, 0 <= k < b-1 =>
    incomplete_constraints x y m (entries k) p (entries (k+1)) (slopes k).

lemma accepted_entry_nonzero x y m p v b entries slopes k :
  accepted_table_row x y m p v b entries slopes =>
  0 <= k < b => entries k <> idR.
proof.
rewrite /accepted_table_row.
move=> [Hb [Hp [Hv [Hx [Hinit Hsteps]]]]] Hk.
case (k=0); first smt(op_inv op_id).
move=> Hk0. have H := Hsteps (k-1) _; first smt().
move: H. rewrite /incomplete_constraints. smt().
qed.

lemma accepted_entry_not_base x y m p v b entries slopes k :
  coordinate_laws x y m =>
  accepted_table_row x y m p v b entries slopes =>
  0 <= k < b => entries k <> p.
proof.
move=> Hcoord Hrow Hk.
move: (Hrow). rewrite /accepted_table_row.
move=> [Hb [Hp [Hv [Hx [Hinit Hsteps]]]]].
have Hneg : (x (-v)-x v) %% m = 0
  by move: Hcoord; rewrite /coordinate_laws; smt().
case (k=0); first smt().
move=> Hk0.
have Hstep := Hsteps (k-1) _; first smt().
have Htwo : (2*y p) %% m <> 0 by move: Hcoord; rewrite /coordinate_laws; smt().
have H := constraints_output_not_base x y m _ _ _ _ Htwo Hstep.
smt().
qed.

lemma accepted_step_safe x y m p v b entries slopes k :
  coordinate_laws x y m =>
  accepted_table_row x y m p v b entries slopes =>
  0 <= k < b-1 => add_safe (entries k) p.
proof.
move=> Hcoord Hrow Hk.
have Hnz := accepted_entry_nonzero x y m p v b entries slopes k Hrow _; first smt().
have Hneq := accepted_entry_not_base x y m p v b entries slopes k Hcoord Hrow _; first smt().
move: (Hrow). rewrite /accepted_table_row.
move=> [Hb [Hp [Hv [Hx [Hinit Hsteps]]]]].
have Hstep := Hsteps k Hk.
have Hnotneg := constraints_inverse_impossible x y m p (entries (k+1)) (slopes k) Hcoord Hp.
rewrite /add_safe. smt(notxdiff).
qed.

lemma accepted_table_entries x y m p v b entries slopes :
  coordinate_laws x y m => safe_constraint_correct x y m =>
  accepted_table_row x y m p v b entries slopes =>
  forall k, 0 <= k < b => entries k = table_entry p v k.
proof.
move=> Hcoord Hcorrect Hrow.
have Hinit : entries 0 = -v by move: Hrow; rewrite /accepted_table_row; smt().
have Hsteps : forall k, 0 <= k < b-1 =>
  incomplete_constraints x y m (entries k) p (entries (k+1)) (slopes k)
  by move: Hrow; rewrite /accepted_table_row; smt().
have Hind : forall k, 0 <= k => k < b => entries k = table_entry p v k.
+ apply intind.
  + move=> Hrange. by rewrite Hinit table_entry0.
  + move=> k Hk IH Hrange.
  have Hrange' : 0 <= k < b by smt().
  have Hsafe := accepted_step_safe x y m p v b entries slopes k Hcoord Hrow _; first smt().
  have Hstep := Hsteps k _; first smt().
  have Hsum : entries (k+1) = entries k +++ p by move: Hcorrect; rewrite /safe_constraint_correct; smt().
  by rewrite Hsum (IH _) 1:/# table_entryS.
move=> k [Hk Hb]. exact (Hind k Hk Hb).
qed.

(* Thus the guards in TableBuilder are redundant for accepting witnesses.
   This is soundness, not a claim that every initial offset is admissible. *)
lemma accepted_table_row_safe x y m p v b entries slopes :
  coordinate_laws x y m => safe_constraint_correct x y m =>
  accepted_table_row x y m p v b entries slopes => row_safe p v b.
proof.
move=> Hcoord Hcorrect Hrow.
have Hentries := accepted_table_entries x y m p v b entries slopes Hcoord Hcorrect Hrow.
have Hnz := accepted_entry_nonzero x y m p v b entries slopes.
have Hsafe := accepted_step_safe x y m p v b entries slopes.
rewrite /row_safe.
have Hp : p <> idR by move: Hrow; rewrite /accepted_table_row; smt().
split; first exact Hp.
split.
+ move=> k Hk. rewrite -(Hentries k Hk). exact (Hnz k Hrow Hk).
+ move=> k Hk. have Hk' : 0 <= k < b by smt().
  rewrite -(Hentries k Hk'). have H := Hsafe k Hcoord Hrow Hk.
  move: H. rewrite /add_safe. smt().
qed.

lemma accepted_table_builder_succeeds x y m p v b entries slopes :
  coordinate_laws x y m => safe_constraint_correct x y m =>
  accepted_table_row x y m p v b entries slopes =>
  phoare [TableBuilder.row : arg = (p,v,b) ==>
    res.`1 /\ forall k, 0 <= k < b => res.`2 k = entries k] = 1%r.
proof.
move=> Hcoord Hcorrect Hrow.
have Hsafe := accepted_table_row_safe x y m p v b entries slopes Hcoord Hcorrect Hrow.
have Hentries := accepted_table_entries x y m p v b entries slopes Hcoord Hcorrect Hrow.
have Hb : 0 < b by move: Hrow; rewrite /accepted_table_row; smt().
conseq (table_row_spec p v b Hb); smt().
qed.

(* The implied guard is also the actual modular coordinate inequality. *)
lemma accepted_step_distinct_x x y m p v b entries slopes k :
  coordinate_laws x y m =>
  accepted_table_row x y m p v b entries slopes =>
  0 <= k < b-1 => (x p - x (entries k)) %% m <> 0.
proof.
move=> Hcoord Hrow Hk.
have Hsafe := accepted_step_safe x y m p v b entries slopes k Hcoord Hrow Hk.
move: Hsafe Hcoord. rewrite /add_safe /coordinate_laws. smt().
qed.

op accepted_tables (x y : R -> int) m P U table slopes =
  forall j, 0 <= j < l =>
    accepted_table_row x y m (P j) ((2^w-1) *** U) (2^w) (table j) (slopes j).

lemma accepted_tables_safe x y m P U table slopes :
  coordinate_laws x y m => safe_constraint_correct x y m =>
  accepted_tables x y m P U table slopes => table_safe P U.
proof.
rewrite /accepted_tables /table_safe.
move=> Hcoord Hcorrect Hrows j Hj.
exact (accepted_table_row_safe x y m (P j) ((2^w-1) *** U) (2^w)
  (table j) (slopes j) Hcoord Hcorrect (Hrows j Hj)).
qed.

lemma accepted_tables_match x y m P U table slopes :
  coordinate_laws x y m => safe_constraint_correct x y m =>
  accepted_tables x y m P U table slopes => table_matches table P U.
proof.
rewrite /accepted_tables /table_matches.
move=> Hcoord Hcorrect Hrows j k Hj Hk.
have H := accepted_table_entries x y m (P j) ((2^w-1) *** U) (2^w)
  (table j) (slopes j) Hcoord Hcorrect (Hrows j Hj) k Hk.
move: H. rewrite /table_entry /perfect_table_pure. smt().
qed.

(* The MSM consumes witnessed table entries directly, without executing the
   guarded builder. All table guards follow from the accepted constraints. *)
lemma constraint_table_msm_soundness x y m P s U table slopes :
  coordinate_laws x y m => safe_constraint_correct x y m =>
  accepted_tables x y m P U table slopes => valid_windows s =>
  phoare [ConstructedMSM.with_table : arg = (P,s,U,table) ==>
    res.`1 => res.`2 = multiScalarMul_Simpl s P T l] = 1%r.
proof.
move=> Hcoord Hcorrect Hrows Hwindows.
have Hsafe := accepted_tables_safe x y m P U table slopes Hcoord Hcorrect Hrows.
have Hmatch := accepted_tables_match x y m P U table slopes Hcoord Hcorrect Hrows.
conseq (with_table_soundness P s U table); smt().
qed.

end MSM_TableConstraints.

theory MSM_WindowOrder.
require import AllCore Int IntDiv StdOrder.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MSM_TableConstruction MSM_WithTable MSM_RejectionBound MSM_TableConstraints.


(* The core consumes the most significant window first. The paper and
   Lean artifact describe least-significant-window-first input arrays. *)
op reverse_windows n (s : int -> int -> int) = fun j i => s j (n-1-i).

lemma reverse_windows_involutive n s :
  reverse_windows n (reverse_windows n s) = s.
proof. rewrite /reverse_windows. apply fun_ext=> j. apply fun_ext=> i. smt(). qed.

lemma reverse_windows_valid s :
  valid_windows (reverse_windows T s) <=> valid_windows s.
proof.
rewrite /valid_windows /reverse_windows. split.
+ move=> H j i Hj Hi. have Hidx : 0 <= T-1-i < T by smt().
  have Hval := H j (T-1-i) Hj Hidx. smt().
+ move=> H j i Hj Hi. apply (H j (T-1-i)); smt().
qed.

(* Independent little-endian specification: weight of input window i is
   2^(w*i), rather than the core's 2^(w*(n-1-i)). *)
op msm_little_endian s P n count =
  iteri n (fun i acc => acc +++
    iteri count (fun j part => part +++
      (2^(w*i) * s j i) *** (P j)) idR) idR.

lemma group_sum_shift : forall n, 0 <= n => forall (f : int -> R),
  iteri (n+1) (fun i acc => acc +++ f i) idR =
  f 0 +++ iteri n (fun i acc => acc +++ f (i+1)) idR.
proof.
apply intind.
+ move=> f. rewrite iteriS 1:/# /= !iteri0 1,2:/# /=. smt(op_id op_id').
+ move=> n Hn IH f.
  rewrite iteriS 1:/# /= (IH f).
  rewrite iteriS 1:/# /=. smt(op_assoc).
qed.

lemma group_sum_reverse : forall n, 0 <= n => forall (f : int -> R),
  iteri n (fun i acc => acc +++ f (n-1-i)) idR =
  iteri n (fun i acc => acc +++ f i) idR.
proof.
apply intind.
+ move=> f. by rewrite !iteri0 1,2:/#.
+ move=> n Hn IH f.
  rewrite iteriS 1:/# /=.
  have E : (fun i acc => acc +++ f (n+1-1-i)) =
    (fun i acc => acc +++ (fun k => f (k+1)) (n-1-i)).
  + apply fun_ext=> i. apply fun_ext=> acc. smt().
  rewrite E (IH (fun k => f (k+1))) /=.
  rewrite group_sum_shift 1:/#.
  smt(op_comm).
qed.

lemma reversed_core_spec s P n count : 0 <= n =>
  multiScalarMul_Simpl (reverse_windows n s) P n count =
  msm_little_endian s P n count.
proof.
move=> Hn. rewrite /multiScalarMul_Simpl /reverse_windows /msm_little_endian.
apply (group_sum_reverse n Hn (fun i =>
  iteri count (fun j part => part +++ (2^(w*i)*s j i) *** (P j)) idR)).
qed.

(* Reindexing is a function view: no extra group operations or constraints.
   The first core iteration reads input T-1; the last reads input 0. *)
module LittleEndianMSM = {
  proc with_table(P : int -> R, s : int -> int -> int, U : R,
                  table : int -> int -> R) = {
    var result : bool * R;
    result <@ ConstructedMSM.with_table(P,reverse_windows T s,U,table);
    return result;
  }

  proc run(P : int -> R, s : int -> int -> int, U : R) = {
    var result : bool * R;
    result <@ ConstructedMSM.run(P,reverse_windows T s,U);
    return result;
  }
}.

module SampledLittleEndianMSM = {
  proc run(P : int -> R, s : int -> int -> int) = {
    var result : bool * R;
    result <@ SampledConstructedMSM.run(P,reverse_windows T s);
    return result;
  }
}.

lemma little_endian_msm_soundness P s U :
  phoare [LittleEndianMSM.run : arg = (P,s,U) ==>
    res.`1 => res.`2 = msm_little_endian s P T l] = 1%r.
proof.
proc. ecall (constructed_msm_soundness P (reverse_windows T s) U).
skip. smt(reversed_core_spec param_pos).
qed.

lemma sampled_little_endian_soundness P s :
  phoare [SampledLittleEndianMSM.run : arg = (P,s) ==>
    res.`1 => res.`2 = msm_little_endian s P T l] = 1%r.
proof.
proc. ecall (sampled_constructed_msm_soundness P (reverse_windows T s)).
skip. smt(reversed_core_spec param_pos).
qed.

lemma sampled_little_endian_equiv :
  equiv [SampledLittleEndianMSM.run ~ SampledConstructedMSM.run :
    P{1}=P{2} /\ s{2}=reverse_windows T s{1} ==> ={res}].
proof.
proc*. inline SampledLittleEndianMSM.run. wp.
call (_: true).
+ sim.
+ auto.
qed.

lemma little_endian_rejection_bound P s &m :
  nonzero_bases P => valid_windows s =>
  scalar_invertible (2^w-1) => scalar_invertible l =>
  Pr[SampledLittleEndianMSM.run(P,s) @ &m : !res.`1]
  <= (1 + l*(2^w+1) + 2*T*l)%r / group_cardinality%r.
proof.
move=> HP Hs Htable Hinitial.
have -> : Pr[SampledLittleEndianMSM.run(P,s) @ &m : !res.`1] =
  Pr[SampledConstructedMSM.run(P,reverse_windows T s) @ &m : !res.`1].
+ byequiv sampled_little_endian_equiv; smt().
apply sampled_rejection_bound_cardinality; smt(reverse_windows_valid).
qed.

lemma little_endian_success_bound P s &m :
  nonzero_bases P => valid_windows s =>
  scalar_invertible (2^w-1) => scalar_invertible l =>
  1%r - (1 + l*(2^w+1) + 2*T*l)%r / group_cardinality%r
  <= Pr[SampledLittleEndianMSM.run(P,s) @ &m : res.`1].
proof.
move=> HP Hs Htable Hinitial.
have -> : Pr[SampledLittleEndianMSM.run(P,s) @ &m : res.`1] =
  Pr[SampledConstructedMSM.run(P,reverse_windows T s) @ &m : res.`1].
+ byequiv sampled_little_endian_equiv; smt().
apply sampled_success_bound_cardinality; smt(reverse_windows_valid).
qed.

lemma little_endian_constraint_table_soundness x y m P s U table slopes :
  coordinate_laws x y m => safe_constraint_correct x y m =>
  accepted_tables x y m P U table slopes => valid_windows s =>
  phoare [LittleEndianMSM.with_table : arg = (P,s,U,table) ==>
    res.`1 => res.`2 = msm_little_endian s P T l] = 1%r.
proof.
move=> Hcoord Hcorrect Hrows Hwindows.
have Hrev : valid_windows (reverse_windows T s) by smt(reverse_windows_valid).
proc. ecall (constraint_table_msm_soundness x y m P (reverse_windows T s) U table slopes
  Hcoord Hcorrect Hrows Hrev).
skip. smt(reversed_core_spec param_pos).
qed.

end MSM_WindowOrder.

theory MSM_CoordinateWitnesses.
require import AllCore Int IntDiv StdOrder.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MultiScalarMul_Abstract_Completeness MSM_TableConstruction MSM_WithTable.

require import AffineAddition.
import MSM_TableConstraints MSM_RejectionBound MSM_WindowOrder.

import Ring.IntID IntOrder.

(* Representation obligations for the already abstract group. The last
   clause specifies its addition via the standard affine formulas. No
   constraint soundness or witness-existence property is assumed here. *)
op affine_group_model (x y : R -> int) m =
  prime m /\
  (forall a b, a <> idR => b <> idR =>
    eqm m (x a) (x b) => eqm m (y a) (y b) => a=b) /\
  (forall a b, add_safe a b =>
    let sl = affine_slope m (x a) (y a) (x b) (y b) in
    let sx = affine_x (x a) (x b) sl in
    eqm m (x (a +++ b)) sx /\
    eqm m (y (a +++ b)) (affine_y (x a) (y a) sx sl)).

op coordinate_slope (x y : R -> int) m a b =
  affine_slope m (x a) (y a) (x b) (y b).

lemma incomplete_equationsE x y m a b r lam :
  incomplete_constraints x y m a b r lam <=>
  r <> idR /\ affine_equations m (x a) (y a) (x b) (y b) (x r) (y r) lam.
proof. rewrite /incomplete_constraints /slope_constraint /affine_equations. smt(). qed.

lemma safe_coordinate_denominator x y m a b :
  coordinate_laws x y m => add_safe a b => (x b-x a) %% m <> 0.
proof. rewrite /coordinate_laws /add_safe. smt(). qed.

lemma safe_sum_nonzero x y m a b :
  coordinate_laws x y m => add_safe a b => a +++ b <> idR.
proof.
move=> Hcoord Hsafe.
have Hden := safe_coordinate_denominator x y m a b Hcoord Hsafe.
have Hb : b <> idR by move: Hsafe; rewrite /add_safe; smt().
have Hneg : (x (-b)-x b) %% m = 0
  by move: Hcoord; rewrite /coordinate_laws; smt().
case (a +++ b = idR); last smt().
move=> Hzero. have Heq : a = -b by smt(op_eq_neg).
have Hx : eqm m (x (-b)) (x b) by smt(congr_zero).
smt(congr_zero).
qed.

lemma safe_constraint_correct_from_model x y m :
  coordinate_laws x y m => affine_group_model x y m => safe_constraint_correct x y m.
proof.
move=> Hcoord. rewrite /affine_group_model.
move=> [Hprime [Hinj Hlaw]]. rewrite /safe_constraint_correct.
move=> a b r lam Hsafe. rewrite incomplete_equationsE. move=> [Hr Heq].
have Hnz := safe_coordinate_denominator x y m a b Hcoord Hsafe.
have Huniq := affine_equations_unique m (x a) (y a) (x b) (y b) (x r) (y r) lam Hprime Hnz Heq.
have Hsum := Hlaw a b Hsafe.
have Hnonzero := safe_sum_nonzero x y m a b Hcoord Hsafe.
apply (Hinj r (a +++ b)); smt().
qed.

lemma safe_constraint_witness x y m a b :
  coordinate_laws x y m => affine_group_model x y m => add_safe a b =>
  incomplete_constraints x y m a b (a +++ b) (coordinate_slope x y m a b).
proof.
move=> Hcoord. rewrite /affine_group_model.
move=> [Hprime [Hinj Hlaw]] Hsafe.
have Hnz := safe_coordinate_denominator x y m a b Hcoord Hsafe.
have Hs := affine_slope_valid m (x a) (y a) (x b) (y b) Hprime Hnz.
have Hsum := Hlaw a b Hsafe. move: Hsum. simplify. move=> [Hx Hy].
have Hnonzero := safe_sum_nonzero x y m a b Hcoord Hsafe.
rewrite incomplete_equationsE affine_equationsE /coordinate_slope.
have Hyy := affine_y_congr m (x a) (y a) (x (a +++ b))
  (affine_x (x a) (x b) (affine_slope m (x a) (y a) (x b) (y b)))
  (affine_slope m (x a) (y a) (x b) (y b))
  (affine_slope m (x a) (y a) (x b) (y b)) Hx
  (eqm_refl m (affine_slope m (x a) (y a) (x b) (y b))).
smt().
qed.

op row_slopes x y m p v = fun k => coordinate_slope x y m (table_entry p v k) p %% m.

lemma safe_row_initial_check x y m p v b :
  coordinate_laws x y m => 2 <= b => row_safe p v b =>
  v <> idR /\ (x p-x v) %% m <> 0.
proof.
move=> Hcoord Hb. rewrite /row_safe. move=> [Hp [Hnz Hdiff]].
have Hzero : table_entry p v 0 = -v by apply table_entry0.
have Hv : v <> idR by smt(op_inv op_id').
have Hstep : xdiff (-v) p by smt().
have Hden : (x p-x (-v)) %% m <> 0.
+ apply (safe_coordinate_denominator x y m (-v) p Hcoord).
  rewrite /add_safe. smt().
have Hneg : (x (-v)-x v) %% m = 0
  by move: Hcoord; rewrite /coordinate_laws; smt().
have Heq : eqm m (x (-v)) (x v) by smt(congr_zero).
have Hdx := eqmB m (x p) (x p) (x (-v)) (x v) (eqm_refl m (x p)) Heq.
smt().
qed.

lemma safe_row_has_witnesses x y m p v b :
  coordinate_laws x y m => affine_group_model x y m =>
  2 <= b => row_safe p v b =>
  accepted_table_row x y m p v b (table_entry p v) (row_slopes x y m p v).
proof.
move=> Hcoord Hmodel Hb Hsafe.
have Hinitial := safe_row_initial_check x y m p v b Hcoord Hb Hsafe.
move: (Hsafe). rewrite /row_safe. move=> [Hp [Hnz Hdiff]].
rewrite /accepted_table_row. split; first smt().
split; first exact Hp. split; first smt(). split; first smt().
split; first exact (table_entry0 p v).
move=> k Hk.
have Hstep : add_safe (table_entry p v k) p by rewrite /add_safe; smt().
have H := safe_constraint_witness x y m (table_entry p v k) p Hcoord Hmodel Hstep.
rewrite /row_slopes table_entryS incomplete_equationsE.
move: H. rewrite incomplete_equationsE. move=> [Hnonzero Heq].
split; first exact Hnonzero. exact (affine_equations_slope_residue m _ _ _ _ _ _ _ Heq).
qed.

lemma table_row_constraints_iff_safe x y m p v b :
  coordinate_laws x y m => affine_group_model x y m => 2 <= b =>
  ((exists entries slopes, accepted_table_row x y m p v b entries slopes)
    <=> row_safe p v b).
proof.
move=> Hcoord Hmodel Hb. split.
+ move=> [entries slopes Hrow].
  exact (accepted_table_row_safe x y m p v b entries slopes Hcoord
    (safe_constraint_correct_from_model x y m Hcoord Hmodel) Hrow).
+ move=> Hsafe. exists (table_entry p v) (row_slopes x y m p v).
  exact (safe_row_has_witnesses x y m p v b Hcoord Hmodel Hb Hsafe).
qed.

lemma window_table_width : 2 <= 2^w.
proof.
have Hw : 0 < w by smt(param_pos).
have Hpow : 0 < 2^(w-1) by smt(expr_gt0).
have Heq : 2^w = 2*2^(w-1) by rewrite expr_pred; smt().
smt().
qed.

op table_slopes x y m (P : int -> R) U = fun j =>
  row_slopes x y m (P j) ((2^w-1) *** U).

lemma safe_table_has_witnesses x y m P U :
  coordinate_laws x y m => affine_group_model x y m => table_safe P U =>
  accepted_tables x y m P U (perfect_table_pure P U) (table_slopes x y m P U).
proof.
move=> Hcoord Hmodel. rewrite /table_safe. move=> Hsafe.
rewrite /accepted_tables /table_slopes. move=> j Hj.
have H := safe_row_has_witnesses x y m (P j) ((2^w-1) *** U) (2^w)
  Hcoord Hmodel window_table_width (Hsafe j Hj).
move: H. rewrite /table_entry /perfect_table_pure. smt().
qed.

lemma table_constraints_iff_safe x y m P U :
  coordinate_laws x y m => affine_group_model x y m =>
  ((exists table slopes, accepted_tables x y m P U table slopes) <=> table_safe P U).
proof.
move=> Hcoord Hmodel. split.
+ move=> [table slopes Haccepted].
  exact (accepted_tables_safe x y m P U table slopes Hcoord
    (safe_constraint_correct_from_model x y m Hcoord Hmodel) Haccepted).
+ move=> Hsafe. exists (perfect_table_pure P U) (table_slopes x y m P U).
  exact (safe_table_has_witnesses x y m P U Hcoord Hmodel Hsafe).
qed.

(* The probability is now about existence of satisfying coordinate-table
   witnesses, not merely success of the abstract guarded row builder. *)
lemma table_witness_failure_bound x y m P :
  coordinate_laws x y m => affine_group_model x y m =>
  nonzero_bases P => scalar_invertible (2^w-1) =>
  mu r_distr (fun u => ! (exists table slopes, accepted_tables x y m P u table slopes))
  <= (l*(2^w+1))%r / group_cardinality%r.
proof.
move=> Hcoord Hmodel HP Hinv.
have Heq : (fun u => ! (exists table slopes, accepted_tables x y m P u table slopes)) =
  (fun u => ! table_safe P u)
  by apply fun_ext=> u; smt(table_constraints_iff_safe).
rewrite Heq.
have H := table_rejection_bound P HP Hinv.
move: H. rewrite point_mass_cardinality. smt(Real.fromintM).
qed.

(* Only the table component is expressed by coordinate constraints here;
   doubling, offset calculation and the MSM loop retain their abstract
   semantics. This is not a full coordinate-circuit completeness theorem. *)
op table_witness_pipeline_accepts x y m P s u =
  (exists table slopes, accepted_tables x y m P u table slopes) /\
  valid_windows s /\ l *** u <> idR /\ loop_ok P s u.

lemma table_witness_pipeline_equiv x y m P s u :
  coordinate_laws x y m => affine_group_model x y m =>
  table_witness_pipeline_accepts x y m P s u = construction_accepts P s u.
proof.
move=> Hcoord Hmodel.
rewrite /table_witness_pipeline_accepts /construction_accepts.
smt(table_constraints_iff_safe).
qed.

lemma little_endian_table_witness_failure_bound x y m P s :
  coordinate_laws x y m => affine_group_model x y m =>
  nonzero_bases P => valid_windows s =>
  scalar_invertible (2^w-1) => scalar_invertible l =>
  mu r_distr (fun u => !table_witness_pipeline_accepts x y m P (reverse_windows T s) u)
  <= (1+l*(2^w+1)+2*T*l)%r / group_cardinality%r.
proof.
move=> Hcoord Hmodel HP Hs Htable Hinitial.
have Heq : (fun u => !table_witness_pipeline_accepts x y m P (reverse_windows T s) u) =
  (fun u => !construction_accepts P (reverse_windows T s) u)
  by apply fun_ext=> u; smt(table_witness_pipeline_equiv).
rewrite Heq.
have Hvalid : valid_windows (reverse_windows T s) by smt(reverse_windows_valid).
have H := construction_failure_mass P (reverse_windows T s) HP Hvalid Htable Hinitial.
move: H. rewrite /rejection_bound point_mass_cardinality. smt().
qed.

lemma modeled_little_endian_table_soundness x y m P s U table slopes :
  coordinate_laws x y m => affine_group_model x y m =>
  accepted_tables x y m P U table slopes => valid_windows s =>
  phoare [LittleEndianMSM.with_table : arg=(P,s,U,table) ==>
    res.`1 => res.`2 = msm_little_endian s P T l] = 1%r.
proof.
move=> Hcoord Hmodel Htable Hwindows.
exact (little_endian_constraint_table_soundness x y m P s U table slopes Hcoord
  (safe_constraint_correct_from_model x y m Hcoord Hmodel) Htable Hwindows).
qed.

lemma table_slopes_bounded x y m P U j k : affine_group_model x y m =>
  0 <= table_slopes x y m P U j k < m.
proof.
rewrite /affine_group_model /table_slopes /row_slopes.
smt(modz_ge0 ltz_pmod gt0_prime).
qed.

end MSM_CoordinateWitnesses.

theory MSM_CompleteCoordinates.
require import AllCore Int IntDiv StdOrder.

require import AffineAddition AffineDoubling AffineComplete.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MSM_TableConstruction MSM_TableConstraints MSM_CoordinateWitnesses.

import Ring.IntID IntOrder.

op group_point (x y : R -> int) (a : R) : coordinate_point =
  if a=idR then infinity else (false,x a,y a).

(* Explicit, uninstantiated representation obligations. The safe-addition
   model is reused, and the tangent formula for group doubling is added.
   Coordinates are canonical; curve membership is required only for inputs
   to the representation, never assumed for raw witnessed output tuples. *)
op complete_affine_model (x y : R -> int) m ca cb =
  affine_group_model x y m /\
  (forall a, a<>idR => 0 <= x a < m /\ 0 <= y a < m /\
    on_affine_curve m ca cb (x a) (y a)) /\
  (forall a, a<>idR =>
    let sl = doubling_slope m ca (x a) (y a) in
    let sx = affine_x (x a) (x a) sl in
    eqm m (x (a +++ a)) sx /\
    eqm m (y (a +++ a)) (affine_y (x a) (y a) sx sl)).

lemma group_point_on_curve x y m ca cb a : complete_affine_model x y m ca cb =>
  point_on_curve m ca cb (group_point x y a).
proof. rewrite /complete_affine_model /point_on_curve /group_point /infinity. smt(). qed.

lemma group_point_normal x y m ca cb a : complete_affine_model x y m ca cb =>
  normalize_point m (group_point x y a) = group_point x y a.
proof.
rewrite /complete_affine_model /affine_group_model.
move=> [[Hp Hmodel] [Hcoords Hdbl]].
case (a=idR).
+ move=> Ha. by rewrite /normalize_point /group_point Ha /infinity /=.
move=> Ha. have H := Hcoords a Ha.
rewrite /normalize_point /group_point Ha /=. smt(modz_small gt0_prime).
qed.

lemma group_point_injective x y m ca cb a b : complete_affine_model x y m ca cb =>
  group_point x y a = group_point x y b => a=b.
proof. rewrite /complete_affine_model /affine_group_model /group_point /infinity. smt(). qed.

lemma double_nonzero a : a<>idR => a +++ a <> idR.
proof.
move=> Ha.
have H := no_order_two_elems a 1 Ha _; first smt().
have Epow : 2^1=1+1 by rewrite expr1.
have E : 2^1 *** a = a +++ a by rewrite Epow nplus_dist !one_mul.
smt().
qed.

lemma complete_add_group x y m ca cb a b :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  complete_add m ca (group_point x y a) (group_point x y b) = group_point x y (a +++ b).
proof.
move=> Hcoord Hmodel.
have Hnorma := group_point_normal x y m ca cb a Hmodel.
have Hnormb := group_point_normal x y m ca cb b Hmodel.
case (a=idR).
+ move=> ->. rewrite op_id' /complete_add /group_point /infinity /=.
  move: Hnormb. rewrite /group_point. smt().
move=> Ha. case (b=idR).
+ move=> ->. rewrite op_id /complete_add /group_point /infinity Ha /=.
  move: Hnorma. rewrite /group_point Ha. smt().
move=> Hb.
move: (Hmodel). rewrite /complete_affine_model /affine_group_model.
move=> [[Hp [Hinj Hadd]] [Hcoords Hdbl]].
rewrite /complete_add /group_point Ha Hb /=.
case ((x b-x a) %% m <> 0).
+ move=> Hdx.
  have Hsafe : add_safe a b by move: Hcoord; rewrite /coordinate_laws /add_safe; smt().
  have Hnonzero := safe_sum_nonzero x y m a b Hcoord Hsafe.
  have Hlaw := Hadd a b Hsafe.
  have Hrange := Hcoords (a +++ b) Hnonzero.
  rewrite Hnonzero /normalize_point /=.
  move: Hlaw. simplify. move=> [Hx Hy].
  have Hxm : x (a +++ b) %% m = x (a +++ b) by smt(modz_small gt0_prime).
  have Hym : y (a +++ b) %% m = y (a +++ b) by smt(modz_small gt0_prime).
  smt().
move=> Hdx.
have Hnot : !xdiff a b by move: Hcoord; rewrite /coordinate_laws; smt().
have Hcases := notxdiff a b Hnot.
case ((y b+y a) %% m = 0).
+ move=> Hsum.
  have Htwo : (2*y a) %% m <> 0 by move: Hcoord; rewrite /coordinate_laws; smt().
  have Hab : a = -b by smt().
  have Hzero : a +++ b = idR by smt(op_eq_neg).
  rewrite Hzero. trivial.
move=> Hsum.
have Hneg : (y (-b)+y b) %% m = 0 by move: Hcoord; rewrite /coordinate_laws; smt().
have Hab : a=b by smt().
subst b.
have Hnonzero := double_nonzero a Ha.
have Hlaw := Hdbl a Ha.
have Hrange := Hcoords (a +++ a) Hnonzero.
rewrite Hnonzero /normalize_point /=.
  move: Hlaw. simplify. move=> [Hx Hy].
  have Hxm : x (a +++ a) %% m = x (a +++ a) by smt(modz_small gt0_prime).
  have Hym : y (a +++ a) %% m = y (a +++ a) by smt(modz_small gt0_prime).
  smt().
qed.

lemma complete_group_witness x y m ca cb a b :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  exists lam, complete_constraints m ca (group_point x y a) (group_point x y b)
    (group_point x y (a +++ b)) lam.
proof.
move=> Hcoord Hmodel.
have Hp : prime m by move: Hmodel; rewrite /complete_affine_model /affine_group_model; smt().
have Ha := group_point_on_curve x y m ca cb a Hmodel.
have Hb := group_point_on_curve x y m ca cb b Hmodel.
have H := complete_add_has_witness m ca cb (group_point x y a) (group_point x y b) Hp Ha Hb.
have E := complete_add_group x y m ca cb a b Hcoord Hmodel.
move: H. by rewrite E.
qed.

(* The output is a raw tuple. Its correctness and curve membership do not
   rely on assuming it encodes some abstract group element. *)
lemma complete_group_sound x y m ca cb a b r lam :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  complete_constraints m ca (group_point x y a) (group_point x y b) r lam =>
  r = group_point x y (a +++ b).
proof.
move=> Hcoord Hmodel H.
have Hp : prime m by move: Hmodel; rewrite /complete_affine_model /affine_group_model; smt().
have E := complete_constraints_sound m ca (group_point x y a) (group_point x y b) r lam Hp H.
have Egroup := complete_add_group x y m ca cb a b Hcoord Hmodel.
smt().
qed.

end MSM_CompleteCoordinates.

theory MSM_CoordinateTrace.
require import AllCore Int IntDiv StdOrder.

require import AffineAddition AffineComplete.
import MSM_CompleteCoordinates.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract IterationProps MSM_TableConstruction MSM_TableConstraints MSM_CoordinateWitnesses.

import Ring.IntID IntOrder.

op complete_step m ca a b r = exists lam, complete_constraints m ca a b r lam.
op coordinate_safe m (a b : coordinate_point) =
  !a.`1 /\ !b.`1 /\ (b.`2-a.`2) %% m <> 0.
op incomplete_step m (a b r : coordinate_point) =
  !a.`1 /\ !b.`1 /\ !r.`1 /\ point_bounded m r /\
  exists lam, 0 <= lam < m /\ affine_equations m a.`2 a.`3 b.`2 b.`3 r.`2 r.`3 lam.
op guarded_step m a b r = coordinate_safe m a b /\ incomplete_step m a b r.
op negate_point m (a : coordinate_point) : coordinate_point =
  if a.`1 then infinity else (false,a.`2 %% m,(-a.`3) %% m).

lemma group_point_flag x y a : (group_point x y a).`1 = (a=idR).
proof. by rewrite /group_point /infinity; case (a=idR). qed.

lemma group_point_bounded x y m ca cb a : complete_affine_model x y m ca cb =>
  point_bounded m (group_point x y a).
proof.
move=> H. rewrite /point_bounded /group_point /infinity.
case (a=idR); first smt(). move=> Ha.
move: H. rewrite /complete_affine_model. smt().
qed.

lemma complete_step_group x y m ca cb a b r :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  (complete_step m ca (group_point x y a) (group_point x y b) r <=>
    r=group_point x y (a +++ b)).
proof.
move=> Hc Hm. rewrite /complete_step. split.
+ move=> [lam H]. exact (complete_group_sound x y m ca cb a b r lam Hc Hm H).
+ move=> ->. exact (complete_group_witness x y m ca cb a b Hc Hm).
qed.

lemma coordinate_safe_group x y m a b : coordinate_laws x y m =>
  (coordinate_safe m (group_point x y a) (group_point x y b) <=> add_safe a b).
proof. rewrite /coordinate_laws /coordinate_safe /group_point /infinity /add_safe. smt(). qed.

lemma incomplete_as_complete m ca a b r : coordinate_safe m a b =>
  (incomplete_step m a b r <=> complete_step m ca a b r).
proof. rewrite /coordinate_safe /incomplete_step /complete_step /complete_constraints. smt(). qed.

lemma guarded_step_group x y m ca cb a b r :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  (guarded_step m (group_point x y a) (group_point x y b) r <=>
    add_safe a b /\ r=group_point x y (a +++ b)).
proof.
move=> Hc Hm. rewrite /guarded_step.
have Hsafe := coordinate_safe_group x y m a b Hc.
have Hcomplete := complete_step_group x y m ca cb a b r Hc Hm.
have Hinc := incomplete_as_complete m ca (group_point x y a) (group_point x y b) r.
smt().
qed.

lemma negate_point_group x y m ca cb a :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  negate_point m (group_point x y a) = group_point x y (-a).
proof.
move=> Hc Hm.
case (a=idR).
+ move=> ->. have E : -idR=idR by smt(op_inv op_id').
  by rewrite /negate_point /group_point /infinity E /=.
move=> Ha. have Hneg : -a <> idR by smt(op_inv op_id).
have Hlaws : (x (-a)-x a) %% m=0 /\ (y (-a)+y a) %% m=0
  by move: Hc; rewrite /coordinate_laws; smt().
have Hbounds := group_point_bounded x y m ca cb (-a) Hm.
move: Hbounds. rewrite /point_bounded /group_point Hneg /=. move=> Hbounds.
have Hx : eqm m (x (-a)) (x a) by smt(congr_zero).
have Hy : eqm m (y (-a)) (-y a).
+ rewrite -congr_zero. have E : y (-a)-(-y a)=y (-a)+y a by ring.
  rewrite E. smt().
rewrite Ha /negate_point /=.
smt(modz_small).
qed.

(* Finite traces contain raw coordinate tuples, with an existential slope
   per edge. Intermediate group membership is never assumed. *)
op coordinate_chain n (step : int -> coordinate_point -> coordinate_point -> bool)
    start finish = 0 <= n /\ exists (nodes : int -> coordinate_point),
  nodes 0=start /\ nodes n=finish /\
  forall i, 0 <= i < n => step i (nodes i) (nodes (i+1)).

lemma coordinate_chain_exists (encode : R -> coordinate_point) step f n a :
  0 <= n =>
  (forall i v, 0 <= i < n => step i (encode v) (encode (f i v))) =>
  coordinate_chain n step (encode a) (encode (iteri n f a)).
proof.
move=> Hn Hstep. rewrite /coordinate_chain. split; first exact Hn.
exists (fun i => encode (iteri i f a)). simplify. split; first by rewrite iteri0.
move=> i Hi. rewrite iteriS 1:/# /=. apply Hstep. exact Hi.
qed.

lemma coordinate_chain_sound (encode : R -> coordinate_point) step f n a r :
  (forall i v z, 0 <= i < n => step i (encode v) z => z=encode (f i v)) =>
  coordinate_chain n step (encode a) r => r=encode (iteri n f a).
proof.
move=> Hstep. rewrite /coordinate_chain. move=> [Hn [nodes [Hfirst [Hlast Hedges]]]].
have Hind : forall k, 0 <= k => k <= n => nodes k=encode (iteri k f a).
+ apply intind.
  + move=> Hk. by rewrite iteri0.
  + move=> k Hk IH Hkn.
    have Hprev := IH _; first smt().
    have H := Hedges k _; first smt().
    move: H. rewrite Hprev. move=> H.
    rewrite iteriS 1:/# /=. apply (Hstep k (iteri k f a) (nodes (k+1))); smt().
smt().
qed.

op doubling_trace m ca n a r =
  coordinate_chain n (fun _ p q => complete_step m ca p p q) a r.
op multiple_trace m ca n a r =
  coordinate_chain n (fun _ p q => complete_step m ca p a q) infinity r.

lemma doubling_iter a : forall n, 0 <= n =>
  iteri n (fun _ p => p +++ p) a = 2^n *** a.
proof.
apply intind; simplify.
+ by rewrite iteri0 1:/# expr0 one_mul.
+ move=> n Hn IH. rewrite iteriS 1:/# /= IH -nplus_dist exprS 1:/#.
  congr. ring.
qed.

lemma doubling_trace_group x y m ca cb n a r :
  coordinate_laws x y m => complete_affine_model x y m ca cb => 0 <= n =>
  (doubling_trace m ca n (group_point x y a) r <=> r=group_point x y (2^n *** a)).
proof.
move=> Hc Hm Hn. rewrite /doubling_trace. split.
+ move=> H. have Hsound := coordinate_chain_sound (group_point x y) _
    (fun _ p => p +++ p) n a r _ H.
  + move=> i v z Hi Hstep. smt(complete_step_group).
  + move: Hsound. by rewrite doubling_iter.
+ move=> ->. rewrite -(doubling_iter a n Hn).
  apply (coordinate_chain_exists (group_point x y) _ (fun _ p => p +++ p) n a Hn).
  move=> i v Hi. smt(complete_step_group).
qed.

lemma multiple_trace_group x y m ca cb n a r :
  coordinate_laws x y m => complete_affine_model x y m ca cb => 0 <= n =>
  (multiple_trace m ca n (group_point x y a) r <=> r=group_point x y (n *** a)).
proof.
move=> Hc Hm Hn. rewrite /multiple_trace.
have Hid : infinity=group_point x y idR by rewrite /group_point.
have Heq : iteri n (fun (_ : int) p => p +++ a) idR=n *** a by apply iteriZZZ.
rewrite Hid. split.
+ move=> H. have Hsound := coordinate_chain_sound (group_point x y) _
    (fun _ p => p +++ a) n idR r _ H.
  + move=> i v z Hi Hstep. smt(complete_step_group).
  + smt().
+ move=> ->. rewrite -Heq. apply (coordinate_chain_exists (group_point x y) _ (fun _ p => p +++ a) n idR Hn).
  move=> i v Hi. smt(complete_step_group).
qed.

lemma coordinate_chain0 step a r : coordinate_chain 0 step a r <=> r=a.
proof.
rewrite /coordinate_chain. split; first smt().
move=> ->. split; first smt(). exists (fun (_ : int) => a). smt().
qed.

lemma coordinate_chainS n step a r : 0 <= n =>
  (coordinate_chain (n+1) step a r <=>
    exists mid, coordinate_chain n step a mid /\ step n mid r).
proof.
move=> Hn. rewrite /coordinate_chain. split.
+ move=> [_ [nodes [H0 [Hlast Hsteps]]]]. exists (nodes n). split.
  + split; first exact Hn. exists nodes. smt().
  + smt().
+ move=> [mid [[_ [nodes [H0 [Hlast Hsteps]]]] Hstep]].
  split; first smt(). exists (fun i => if i=n+1 then r else nodes i).
  split; first smt(). split; first smt(). move=> i Hi. simplify.
  case (i=n); smt().
qed.

op addition_trace m n (table : int -> coordinate_point) a r =
  coordinate_chain n (fun j p q => guarded_step m p (table j) q) a r.
op group_additions n (table : int -> R) a =
  iteri n (fun j (acc : bool * R) =>
    (acc.`1 /\ xdiff acc.`2 (table j),acc.`2 +++ table j)) (true,a).

lemma group_additionsS n table a : 0 <= n =>
  group_additions (n+1) table a =
  ((group_additions n table a).`1 /\ xdiff (group_additions n table a).`2 (table n),
    (group_additions n table a).`2 +++ table n).
proof. move=> Hn. by rewrite /group_additions iteriS 1://. qed.

lemma addition_trace_group x y m ca cb table a :
  coordinate_laws x y m => complete_affine_model x y m ca cb => a<>idR =>
  forall n, 0 <= n => (forall j, 0 <= j < n => table j<>idR) =>
  let result=group_additions n table a in
  (result.`1 => result.`2<>idR) /\
  forall r, addition_trace m n (fun j => group_point x y (table j)) (group_point x y a) r
    <=> result.`1 /\ r=group_point x y result.`2.
proof.
move=> Hc Hm Ha. apply intind; simplify.
+ move=> Htable. rewrite /group_additions iteri0 1:/# /=.
  split; first exact Ha. move=> r. by rewrite /addition_trace coordinate_chain0.
+ move=> n Hn IH Htable.
  have [Hprev_nonzero Hprev] := IH _; first smt().
  rewrite group_additionsS 1:// /=.
  split.
  + move=> [Hflag Hdiff]. have Hsafe : add_safe (group_additions n table a).`2 (table n)
      by rewrite /add_safe; smt().
    smt(safe_sum_nonzero).
  + move=> r. rewrite /addition_trace coordinate_chainS 1://. split.
    + move=> [mid [Hchain Hedge]].
      have HC : addition_trace m n (fun j => group_point x y (table j)) (group_point x y a) mid by exact Hchain.
      have HI := Hprev mid.
      have Hprefix : (group_additions n table a).`1 /\ mid=group_point x y (group_additions n table a).`2 by smt().
      have [Hflag Hmid] := Hprefix.
      move: Hedge. simplify. rewrite Hmid (guarded_step_group x y m ca cb (group_additions n table a).`2 (table n) r Hc Hm) /add_safe. smt().
    + move=> [[Hflag Hdiff] Hr]. exists (group_point x y (group_additions n table a).`2). split.
      + have HC : addition_trace m n (fun j => group_point x y (table j)) (group_point x y a)
          (group_point x y (group_additions n table a).`2) by smt().
        exact HC.
      + simplify. rewrite (guarded_step_group x y m ca cb (group_additions n table a).`2 (table n) r Hc Hm) /add_safe. smt().
qed.

op window_trace m ca (table : int -> int -> coordinate_point) (s : int -> int -> int) (i : int) a r =
  exists d, doubling_trace m ca w a d /\
    addition_trace m l (fun j => table j (s j i)) d r.
op msm_loop_trace m ca n table s a r =
  coordinate_chain n (fun i p q => window_trace m ca table s i p q) a r.

lemma window_trace_group x y m ca cb table s i a :
  coordinate_laws x y m => complete_affine_model x y m ca cb => a<>idR =>
  (forall j, 0 <= j < l => table j (s j i)<>idR) =>
  let result=completeAddLoop l table s i (2^w *** a) in
  (result.`1 => result.`2<>idR) /\
  forall r, window_trace m ca (fun j k => group_point x y (table j k)) s i (group_point x y a) r
    <=> result.`1 /\ r=group_point x y result.`2.
proof.
move=> Hc Hm Ha Htable. simplify.
have Hw : 0 <= w by smt(param_pos).
have Hl : 0 <= l by smt(param_pos).
have Hd : 2^w *** a <> idR by apply no_order_two_elems; smt(param_pos).
have [Hnz Htrace] := addition_trace_group x y m ca cb (fun j => table j (s j i))
  (2^w *** a) Hc Hm Hd l Hl Htable.
have E : group_additions l (fun j => table j (s j i)) (2^w *** a) =
  completeAddLoop l table s i (2^w *** a) by rewrite /group_additions /completeAddLoop.
move: Hnz Htrace. rewrite E. move=> Hnz Htrace.
split; first exact Hnz. move=> r. rewrite /window_trace. split.
+ move=> [d [Hdoub Hadd]].
  have Ed : d=group_point x y (2^w *** a) by smt(doubling_trace_group).
  have H := Htrace r. move: Hadd. rewrite Ed. smt().
+ move=> H. exists (group_point x y (2^w *** a)). split.
  + smt(doubling_trace_group).
  + have H' := Htrace r. smt().
qed.

lemma msm_loopS n table s a : 0 <= n =>
  multiScalarMulLoop (n+1) l table s a w =
  let prev=multiScalarMulLoop n l table s a w in
  let next=completeAddLoop l table s n (2^w *** prev.`2) in
  (prev.`1 /\ next.`1,next.`2).
proof. move=> Hn. by rewrite /multiScalarMulLoop iteriS 1://. qed.

lemma msm_loop_trace_group x y m ca cb table s a :
  coordinate_laws x y m => complete_affine_model x y m ca cb => a<>idR =>
  forall n, 0 <= n =>
  (forall i j, 0 <= i < n => 0 <= j < l => table j (s j i)<>idR) =>
  let result=multiScalarMulLoop n l table s a w in
  (result.`1 => result.`2<>idR) /\
  forall r, msm_loop_trace m ca n (fun j k => group_point x y (table j k)) s (group_point x y a) r
    <=> result.`1 /\ r=group_point x y result.`2.
proof.
move=> Hc Hm Ha. apply intind; simplify.
+ move=> Htable. rewrite /multiScalarMulLoop iteri0 1:/# /=.
  split; first exact Ha. move=> r. by rewrite /msm_loop_trace coordinate_chain0.
+ move=> n Hn IH Htable.
  have [Hprev_nonzero Hprev] := IH _; first smt().
  rewrite msm_loopS 1:// /=. split.
  + move=> [Hflag Hnext].
    have Hnonzero := Hprev_nonzero Hflag.
    have [Hnz Hwindow] := window_trace_group x y m ca cb table s n
      (multiScalarMulLoop n l table s a w).`2 Hc Hm Hnonzero _; first smt().
    smt().
  + move=> r. rewrite /msm_loop_trace coordinate_chainS 1://. split.
    + move=> [mid [Hchain Hedge]].
      have HC : msm_loop_trace m ca n (fun j k => group_point x y (table j k)) s (group_point x y a) mid by exact Hchain.
      have HI := Hprev mid.
      have Hflag : (multiScalarMulLoop n l table s a w).`1 by smt().
      have Hmid : mid=group_point x y (multiScalarMulLoop n l table s a w).`2 by smt().
      have [Hnz Hwindow] := window_trace_group x y m ca cb table s n
        (multiScalarMulLoop n l table s a w).`2 Hc Hm (Hprev_nonzero Hflag) _; first smt().
      have HW := Hwindow r. move: Hedge. simplify. rewrite Hmid. smt().
    + move=> [[Hflag Hnext] Hr].
      exists (group_point x y (multiScalarMulLoop n l table s a w).`2). split.
      + have HC : msm_loop_trace m ca n (fun j k => group_point x y (table j k)) s
          (group_point x y a) (group_point x y (multiScalarMulLoop n l table s a w).`2) by smt().
        exact HC.
      + have [Hnz Hwindow] := window_trace_group x y m ca cb table s n
          (multiScalarMulLoop n l table s a w).`2 Hc Hm (Hprev_nonzero Hflag) _; first smt().
        simplify. have HW := Hwindow r. smt().
qed.

lemma coordinate_chain_ext n step1 step2 a r :
  (forall i p q, 0 <= i < n => step1 i p q = step2 i p q) =>
  coordinate_chain n step1 a r = coordinate_chain n step2 a r.
proof. rewrite /coordinate_chain. smt(). qed.

lemma addition_trace_ext m n table1 table2 a r :
  (forall j, 0 <= j < n => table1 j=table2 j) =>
  addition_trace m n table1 a r = addition_trace m n table2 a r.
proof.
move=> H. rewrite /addition_trace. apply coordinate_chain_ext. smt().
qed.

lemma window_trace_ext m ca table1 table2 s i a r :
  (forall j, 0 <= j < l => table1 j (s j i)=table2 j (s j i)) =>
  window_trace m ca table1 s i a r = window_trace m ca table2 s i a r.
proof.
move=> H. rewrite /window_trace.
have HE : forall d, addition_trace m l (fun j => table1 j (s j i)) d r =
  addition_trace m l (fun j => table2 j (s j i)) d r.
+ move=> d. apply addition_trace_ext. exact H.
smt().
qed.

lemma msm_loop_trace_ext m ca n table1 table2 s a r :
  (forall i j, 0 <= i < n => 0 <= j < l => table1 j (s j i)=table2 j (s j i)) =>
  msm_loop_trace m ca n table1 s a r = msm_loop_trace m ca n table2 s a r.
proof.
move=> H. rewrite /msm_loop_trace. apply coordinate_chain_ext.
move=> i p q Hi. simplify. apply window_trace_ext. smt().
qed.

end MSM_CoordinateTrace.

theory MSM_CoordinateTables.
require import AllCore Int IntDiv StdOrder.

require import AffineAddition AffineComplete.
import MSM_CompleteCoordinates MSM_CoordinateTrace.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MSM_TableConstruction MSM_TableConstraints MSM_CoordinateWitnesses.


(* Exactly one unequal-x check per row. Later row steps carry only the
   original affine equations, finite flags and canonical witness ranges. *)
op coordinate_row m b p v (entries : int -> coordinate_point) =
  2 <= b /\ coordinate_safe m p v /\ entries 0=negate_point m v /\
  forall k, 0 <= k < b-1 => incomplete_step m (entries k) p (entries (k+1)).
op coordinate_tables m (P : int -> coordinate_point) v table =
  forall j, 0 <= j < l => coordinate_row m (2^w) (P j) v (table j).

lemma incomplete_output_not_base m a (b : coordinate_point) r : (2*b.`3) %% m<>0 =>
  incomplete_step m a b r => r<>b.
proof.
move=> Htwo. rewrite /incomplete_step. move=> [_ [_ [_ [_ [lam [_ Heq]]]]]].
case (r=b); last smt(). move=> Er. move: Heq. rewrite Er /affine_equations.
move=> [Hs [_ Hy]].
have H := mod_difference_zero m _ _ Hs Hy.
have E : (b.`3-a.`3-lam*(b.`2-a.`2))-(-b.`3-a.`3-lam*(b.`2-a.`2))=2*b.`3 by ring.
smt().
qed.

lemma incomplete_inverse_impossible x y m p r : coordinate_laws x y m => p<>idR =>
  !incomplete_step m (group_point x y (-p)) (group_point x y p) r.
proof.
move=> Hc Hp. have Hneg : -p<>idR by smt(op_inv op_id).
have [Hx Hy] : (x (-p)-x p) %% m=0 /\ (y (-p)+y p) %% m=0
  by move: Hc; rewrite /coordinate_laws; smt().
have Htwo : (2*y p) %% m<>0 by move: Hc; rewrite /coordinate_laws; smt().
case (incomplete_step m (group_point x y (-p)) (group_point x y p) r); last smt().
move=> Hstep.
have [lam [_ Heq]] : exists lam, 0 <= lam < m /\
  affine_equations m (x (-p)) (y (-p)) (x p) (y p) r.`2 r.`3 lam
  by move: Hstep; rewrite /incomplete_step /group_point Hp Hneg; smt().
move: Heq. rewrite affine_equationsE. move=> [Hs Hrest].
have Hdx : eqm m (x p-x (-p)) 0 by smt(congr_zero mod0z).
have Hmul := eqmM m lam lam (x p-x (-p)) 0 (eqm_refl m lam) Hdx.
have Hdy : (y p-y (-p)) %% m=0 by smt(mod0z).
have Hsum := mod_add_zero m _ _ Hdy Hy.
have E : (y p-y (-p))+(y (-p)+y p)=2*y p by ring.
smt().
qed.

lemma incomplete_inputs_safe x y m a p r :
  coordinate_laws x y m => a<>idR => p<>idR => a<>p =>
  incomplete_step m (group_point x y a) (group_point x y p) r => add_safe a p.
proof.
move=> Hc Ha Hp Hneq Hstep.
have Hinv := incomplete_inverse_impossible x y m p r Hc Hp.
rewrite /add_safe. smt(notxdiff).
qed.

lemma coordinate_row_exists x y m ca cb p v b :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  2 <= b => row_safe p v b =>
  coordinate_row m b (group_point x y p) (group_point x y v)
    (fun k => group_point x y (table_entry p v k)).
proof.
move=> Hc Hm Hb Hsafe.
have Hi := safe_row_initial_check x y m p v b Hc Hb Hsafe.
have Hp : p<>idR by move: Hsafe; rewrite /row_safe; smt().
have Hv : v<>idR by smt().
rewrite /coordinate_row. split; first exact Hb. split.
+ rewrite /coordinate_safe /group_point Hp Hv /=. smt(congr_zero).
split.
+ simplify. rewrite table_entry0 (negate_point_group x y m ca cb v Hc Hm). trivial.
+ move=> k Hk. simplify.
  have Hstep : add_safe (table_entry p v k) p by move: Hsafe; rewrite /row_safe /add_safe; smt().
  have H := guarded_step_group x y m ca cb (table_entry p v k) p
    (group_point x y (table_entry p v (k+1))) Hc Hm.
  have HE : table_entry p v (k+1)=table_entry p v k +++ p by apply table_entryS.
  have HG : guarded_step m (group_point x y (table_entry p v k)) (group_point x y p)
    (group_point x y (table_entry p v (k+1))) by smt().
  move: HG. rewrite /guarded_step. smt().
qed.

lemma coordinate_row_finite m b p v entries k : coordinate_row m b p v entries =>
  0 <= k < b => !(entries k).`1.
proof.
rewrite /coordinate_row /coordinate_safe. move=> [Hb [[Hp [Hv Hx]] [H0 Hsteps]]] Hk.
case (k=0).
+ move=> ->. rewrite H0 /negate_point Hv /=. trivial.
move=> Hk0. have H := Hsteps (k-1) _; first smt().
move: H. rewrite /incomplete_step. smt().
qed.

lemma coordinate_row_not_base m b (p : coordinate_point) v entries k : (2*p.`3) %% m<>0 =>
  coordinate_row m b p v entries => 0 <= k < b => entries k<>p.
proof.
move=> Htwo. rewrite /coordinate_row /coordinate_safe.
move=> [Hb [[Hp [Hv Hx]] [H0 Hsteps]]] Hk.
case (k=0).
+ move=> ->. rewrite H0 /negate_point Hv /=. smt(congr_zero modz_mod).
move=> Hk0. have H := Hsteps (k-1) _; first smt().
have Hneq := incomplete_output_not_base m (entries (k-1)) p (entries k) Htwo _; smt().
qed.

lemma coordinate_row_entries x y m ca cb p v b entries :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  coordinate_row m b (group_point x y p) (group_point x y v) entries =>
  forall k, 0 <= k < b => entries k=group_point x y (table_entry p v k).
proof.
move=> Hc Hm Hrow.
move: (Hrow). rewrite /coordinate_row. move=> [Hb [Hinitial [H0 Hsteps]]].
have Hp : p<>idR by move: Hinitial; rewrite /coordinate_safe !group_point_flag; smt().
have Htwo : (2*(group_point x y p).`3) %% m<>0
  by rewrite /group_point Hp /=; move: Hc; rewrite /coordinate_laws; smt().
have Hind : forall k, 0 <= k => k<b => entries k=group_point x y (table_entry p v k).
+ apply intind; simplify.
  + move=> Hk. rewrite H0 table_entry0 (negate_point_group x y m ca cb v Hc Hm). trivial.
  + move=> k Hk IH Hkb.
    have Hprev := IH _; first smt().
    have Hstep := Hsteps k _; first smt().
    have Hfinite := coordinate_row_finite m b (group_point x y p) (group_point x y v) entries k Hrow _; first smt().
    have Hneq := coordinate_row_not_base m b (group_point x y p) (group_point x y v) entries k Htwo Hrow _; first smt().
    have Ha : table_entry p v k<>idR by move: Hfinite; rewrite Hprev group_point_flag; smt().
    have Hne : table_entry p v k<>p by smt().
    have HS : incomplete_step m (group_point x y (table_entry p v k)) (group_point x y p) (entries (k+1)) by smt().
    have Hsafe := incomplete_inputs_safe x y m (table_entry p v k) p (entries (k+1)) Hc Ha Hp Hne HS.
    have Hguard : guarded_step m (group_point x y (table_entry p v k)) (group_point x y p) (entries (k+1)).
    + rewrite /guarded_step. split; last exact HS. smt(coordinate_safe_group).
    have Hsound := guarded_step_group x y m ca cb (table_entry p v k) p (entries (k+1)) Hc Hm.
    rewrite table_entryS. smt().
smt().
qed.

lemma coordinate_row_safe x y m ca cb p v b entries :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  coordinate_row m b (group_point x y p) (group_point x y v) entries => row_safe p v b.
proof.
move=> Hc Hm Hrow.
have Hentries := coordinate_row_entries x y m ca cb p v b entries Hc Hm Hrow.
move: (Hrow). rewrite /coordinate_row. move=> [Hb [Hinitial [H0 Hsteps]]].
have Hp : p<>idR by move: Hinitial; rewrite /coordinate_safe !group_point_flag; smt().
have Htwo : (2*(group_point x y p).`3) %% m<>0
  by rewrite /group_point Hp /=; move: Hc; rewrite /coordinate_laws; smt().
rewrite /row_safe. split; first exact Hp. split.
+ move=> k Hk. have H := coordinate_row_finite m b (group_point x y p) (group_point x y v) entries k Hrow Hk.
  move: H. rewrite (Hentries k Hk) group_point_flag. trivial.
+ move=> k Hk.
  have Hk' : 0 <= k < b by smt().
  have Hfinite := coordinate_row_finite m b (group_point x y p) (group_point x y v) entries k Hrow Hk'.
  have Hneq := coordinate_row_not_base m b (group_point x y p) (group_point x y v) entries k Htwo Hrow Hk'.
  have Ha : table_entry p v k<>idR by move: Hfinite; rewrite (Hentries k Hk') group_point_flag; smt().
  have Hne : table_entry p v k<>p by smt().
  have HS := Hsteps k Hk.
  move: HS. rewrite (Hentries k Hk'). move=> HS.
  have Hsafe := incomplete_inputs_safe x y m (table_entry p v k) p (entries (k+1)) Hc Ha Hp Hne HS.
  move: Hsafe. rewrite /add_safe. smt().
qed.

lemma coordinate_tables_exists x y m ca cb P U :
  coordinate_laws x y m => complete_affine_model x y m ca cb => table_safe P U =>
  coordinate_tables m (fun j => group_point x y (P j)) (group_point x y ((2^w-1) *** U))
    (fun j k => group_point x y (perfect_table_pure P U j k)).
proof.
move=> Hc Hm Hsafe. rewrite /coordinate_tables. move=> j Hj. simplify.
have HS : row_safe (P j) ((2^w-1) *** U) (2^w) by move: Hsafe; rewrite /table_safe; smt().
have H := coordinate_row_exists x y m ca cb (P j) ((2^w-1) *** U) (2^w) Hc Hm window_table_width HS.
move: H. by rewrite /table_entry /perfect_table_pure.
qed.

lemma coordinate_tables_sound x y m ca cb P U table :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  coordinate_tables m (fun j => group_point x y (P j)) (group_point x y ((2^w-1) *** U)) table =>
  table_safe P U /\ forall j k, 0 <= j < l => 0 <= k < 2^w =>
    table j k=group_point x y (perfect_table_pure P U j k).
proof.
move=> Hc Hm. rewrite /coordinate_tables. move=> Hrows. split.
+ rewrite /table_safe. move=> j Hj.
  have H := Hrows j Hj. move: H. simplify. move=> H.
  exact (coordinate_row_safe x y m ca cb (P j) ((2^w-1) *** U) (2^w) (table j) Hc Hm H).
+ move=> j k Hj Hk. have H := Hrows j Hj.
  have HE := coordinate_row_entries x y m ca cb (P j) ((2^w-1) *** U) (2^w) (table j) Hc Hm H k Hk.
  move: HE. by rewrite /table_entry /perfect_table_pure.
qed.

end MSM_CoordinateTables.

theory MSM_FullCoordinates.
require import AllCore Int IntDiv StdOrder Distr.

require import AffineAddition AffineComplete.
import MSM_CompleteCoordinates MSM_CoordinateTrace MSM_CoordinateTables.

import MultiScalarMul_Abstract_Setup MultiScalarMul_Abstract MultiScalarMul_Abstract_Completeness MSM_TableConstruction MSM_TableConstraints MSM_CoordinateWitnesses MSM_RejectionBound MSM_WindowOrder.

import Ring.IntID IntOrder.

(* All intermediates below are raw coordinate tuples. Offset scalar
   multiplication uses a complete-addition chain for l*U and w doublings
   followed by subtraction for (2^w-1)*U. This specifies witnesses, not a
   particular low-level circuit or an optimal scalar-multiplication cost. *)
op offset_trace m ca u v = exists pow,
  doubling_trace m ca w u pow /\ complete_step m ca pow (negate_point m u) v.

op full_msm_constraints m ca (P : int -> coordinate_point) s u r =
  valid_windows s /\ exists initial v table terminal,
    multiple_trace m ca l u initial /\ !initial.`1 /\
    offset_trace m ca u v /\ coordinate_tables m P v table /\
    msm_loop_trace m ca T table s initial terminal /\
    complete_step m ca terminal (negate_point m initial) r.

lemma offset_trace_group x y m ca cb u v :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  (offset_trace m ca (group_point x y u) v <=> v=group_point x y ((2^w-1) *** u)).
proof.
move=> Hc Hm. have Hw : 0 <= w by smt(param_pos).
have E : 2^w *** u +++ -u = (2^w-1) *** u
  by rewrite (_ : 2^w-1=2^w+(-1)) 1:/# nplus_dist neg_mul one_mul.
rewrite /offset_trace (negate_point_group x y m ca cb u Hc Hm). split.
+ move=> [pow [Hd Ha]].
  have Ed : pow=group_point x y (2^w *** u) by smt(doubling_trace_group).
  move: Ha. rewrite Ed (complete_step_group x y m ca cb (2^w *** u) (-u) v Hc Hm) E. trivial.
+ move=> Hv. exists (group_point x y (2^w *** u)). split.
  + smt(doubling_trace_group).
  + rewrite (complete_step_group x y m ca cb (2^w *** u) (-u) v Hc Hm) E. exact Hv.
qed.

lemma selected_table_nonzero P u s : table_safe P u => valid_windows s =>
  forall i j, 0 <= i < T => 0 <= j < l => perfect_table_pure P u j (s j i)<>idR.
proof.
rewrite /table_safe /row_safe /valid_windows /perfect_table_pure /table_entry. smt().
qed.

lemma functional_final_correct P s u :
  (multiScalarMulLoop T l (perfect_table_pure P u) s (l *** u) w).`2 +++ -(l *** u)
    = multiScalarMul_Simpl s P T l.
proof.
have HT : 0 <= T by smt(param_pos).
have H := spec_equiv_fun_impl T s u P HT.
move: H. rewrite /gg. smt(op_assoc op_inv op_id).
qed.

lemma full_msm_constraints_sound x y m ca cb P s u r :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  full_msm_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r =>
  construction_accepts P s u /\ r=group_point x y (multiScalarMul_Simpl s P T l).
proof.
move=> Hc Hm. rewrite /full_msm_constraints.
move=> [Hwindows [initial v table terminal [Hinitial [Hnonzero [Hoffset [Htables [Hloop Hfinal]]]]]]].
have Hl : 0 <= l by smt(param_pos).
have HT : 0 <= T by smt(param_pos).
have EI : initial=group_point x y (l *** u) by smt(multiple_trace_group).
have EV : v=group_point x y ((2^w-1) *** u) by smt(offset_trace_group).
have Hnz : l *** u<>idR by move: Hnonzero; rewrite EI group_point_flag; smt().
move: Htables. rewrite EV. move=> Htables.
have [Hsafe Hentries] := coordinate_tables_sound x y m ca cb P u table Hc Hm Htables.
have Hselected := selected_table_nonzero P u s Hsafe Hwindows.
have HE := msm_loop_trace_ext m ca T table (fun j k => group_point x y (perfect_table_pure P u j k))
  s initial terminal _.
+ move=> i j Hi Hj. apply Hentries; first exact Hj. move: Hwindows; rewrite /valid_windows; smt().
move: Hloop. rewrite HE EI. move=> Hloop.
have [Hloopnz Hloopiff] := msm_loop_trace_group x y m ca cb (perfect_table_pure P u) s (l *** u)
  Hc Hm Hnz T HT Hselected.
have HL := Hloopiff terminal.
have Hflag : loop_ok P s u by rewrite /loop_ok; smt().
have EL : terminal=group_point x y (multiScalarMulLoop T l (perfect_table_pure P u) s (l *** u) w).`2 by smt().
split; first by rewrite /construction_accepts; smt().
move: Hfinal. rewrite EI EL (negate_point_group x y m ca cb (l *** u) Hc Hm).
rewrite (complete_step_group x y m ca cb
  (multiScalarMulLoop T l (perfect_table_pure P u) s (l *** u) w).`2 (-(l *** u)) r Hc Hm)
  functional_final_correct. trivial.
qed.

lemma full_msm_constraints_exists x y m ca cb P s u :
  coordinate_laws x y m => complete_affine_model x y m ca cb => construction_accepts P s u =>
  full_msm_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u)
    (group_point x y (multiScalarMul_Simpl s P T l)).
proof.
move=> Hc Hm. rewrite /construction_accepts. move=> [Hsafe [Hwindows [Hnz Hflag]]].
have Hl : 0 <= l by smt(param_pos).
have HT : 0 <= T by smt(param_pos).
rewrite /full_msm_constraints. split; first exact Hwindows.
exists (group_point x y (l *** u)) (group_point x y ((2^w-1) *** u))
  (fun j k => group_point x y (perfect_table_pure P u j k))
  (group_point x y (multiScalarMulLoop T l (perfect_table_pure P u) s (l *** u) w).`2).
split; first smt(multiple_trace_group).
split; first by rewrite group_point_flag.
split; first smt(offset_trace_group).
split; first exact (coordinate_tables_exists x y m ca cb P u Hc Hm Hsafe).
split.
+ have Hselected := selected_table_nonzero P u s Hsafe Hwindows.
  have [Hloopnz Hloopiff] := msm_loop_trace_group x y m ca cb (perfect_table_pure P u) s (l *** u)
    Hc Hm Hnz T HT Hselected.
  have H := Hloopiff (group_point x y (multiScalarMulLoop T l (perfect_table_pure P u) s (l *** u) w).`2).
  move: Hflag. rewrite /loop_ok. smt().
+ rewrite (negate_point_group x y m ca cb (l *** u) Hc Hm).
  rewrite (complete_step_group x y m ca cb
    (multiScalarMulLoop T l (perfect_table_pure P u) s (l *** u) w).`2 (-(l *** u))
    (group_point x y (multiScalarMul_Simpl s P T l)) Hc Hm) functional_final_correct. trivial.
qed.

lemma full_msm_constraints_iff x y m ca cb P s u r :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  (full_msm_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r <=>
    construction_accepts P s u /\ r=group_point x y (multiScalarMul_Simpl s P T l)).
proof.
move=> Hc Hm. split.
+ exact (full_msm_constraints_sound x y m ca cb P s u r Hc Hm).
+ move=> [Ha ->]. exact (full_msm_constraints_exists x y m ca cb P s u Hc Hm Ha).
qed.

lemma full_witness_iff x y m ca cb P s u :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  ((exists r, full_msm_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r)
    <=> construction_accepts P s u).
proof.
move=> Hc Hm. split.
+ move=> [r H]. have HS := full_msm_constraints_sound x y m ca cb P s u r Hc Hm H. smt().
+ move=> H. exists (group_point x y (multiScalarMul_Simpl s P T l)).
  exact (full_msm_constraints_exists x y m ca cb P s u Hc Hm H).
qed.

lemma full_witness_failure_bound x y m ca cb P s :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  nonzero_bases P => valid_windows s => scalar_invertible (2^w-1) => scalar_invertible l =>
  mu r_distr (fun u => !exists r,
    full_msm_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r)
  <= (1+l*(2^w+1)+2*T*l)%r / group_cardinality%r.
proof.
move=> Hc Hm HP Hs Htable Hinitial.
have HE : (fun u => !exists r,
    full_msm_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r) =
  (fun u => !construction_accepts P s u)
  by apply fun_ext=> u; have H := full_witness_iff x y m ca cb P s u Hc Hm; smt().
rewrite HE.
have H := construction_failure_mass P s HP Hs Htable Hinitial.
move: H. rewrite /rejection_bound point_mass_cardinality. smt().
qed.

(* External scalar windows remain little endian. *)
op little_endian_full_constraints m ca P s u r =
  full_msm_constraints m ca P (reverse_windows T s) u r.

lemma little_endian_full_sound x y m ca cb P s u r :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  little_endian_full_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r =>
  r=group_point x y (msm_little_endian s P T l).
proof.
move=> Hc Hm. rewrite /little_endian_full_constraints. move=> H.
have [_ Hr] := full_msm_constraints_sound x y m ca cb P (reverse_windows T s) u r Hc Hm H.
move: Hr. rewrite reversed_core_spec 1:/#. trivial.
qed.

lemma little_endian_full_failure_bound x y m ca cb P s :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  nonzero_bases P => valid_windows s => scalar_invertible (2^w-1) => scalar_invertible l =>
  mu r_distr (fun u => !exists r,
    little_endian_full_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r)
  <= (1+l*(2^w+1)+2*T*l)%r / group_cardinality%r.
proof.
move=> Hc Hm HP Hs Htable Hinitial. rewrite /little_endian_full_constraints.
apply (full_witness_failure_bound x y m ca cb P (reverse_windows T s) Hc Hm HP _ Htable Hinitial).
smt(reverse_windows_valid).
qed.

lemma little_endian_full_rejection_mass x y m ca cb P s &mem :
  coordinate_laws x y m => complete_affine_model x y m ca cb =>
  Pr[SampledLittleEndianMSM.run(P,s) @ &mem : !res.`1] =
  mu r_distr (fun u => !exists r,
    little_endian_full_constraints m ca (fun j => group_point x y (P j)) s (group_point x y u) r).
proof.
move=> Hc Hm.
have -> : Pr[SampledLittleEndianMSM.run(P,s) @ &mem : !res.`1] =
  Pr[MSM_WithTable.SampledConstructedMSM.run(P,reverse_windows T s) @ &mem : !res.`1].
+ byequiv sampled_little_endian_equiv; smt().
rewrite sampled_rejection_mass /little_endian_full_constraints.
have HE : (fun u => !construction_accepts P (reverse_windows T s) u) =
  (fun u => !exists r,
    full_msm_constraints m ca (fun j => group_point x y (P j)) (reverse_windows T s) (group_point x y u) r).
+ apply fun_ext=> u. have H := full_witness_iff x y m ca cb P (reverse_windows T s) u Hc Hm. smt().
by rewrite HE.
qed.

end MSM_FullCoordinates.

end Model.
