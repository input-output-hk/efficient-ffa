lemma first_step x y : (bn x) * (bn y)
 = sigma (fun (i : int) => 
     sigma (fun (j : int) => 
       to_uint x.[i]  * to_uint y.[j] * B ^ (i + j))).
proof. 
rewrite /sigma mulr_big /dig big_seq big_seq.
apply eq_bigr => /= i ip /=. 
rewrite big_seq big_seq.
apply eq_bigr => j /= jp /=. 
by rewrite exprD_nneg ; smt(mem_range gt0_nlimbs).
qed.


